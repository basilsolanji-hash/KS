# Пример. Настоящий .env создаёт install.sh со случайными паролями; права 600, в репозиторий не добавлять.
KNITERP_DOMAIN=erp.example.ru
SQL_SA_PASSWORD=
SQL_APP_PASSWORD=
MASTER_KEY=
PREVIOUS_MASTER_KEYS=
SQL_MEMORY_MB=2048
BACKUP_DIR=/opt/kniterp/backups
# Необязательно: ключ Anthropic для ИИ-помощника.
ASSISTANT_API_KEY=
