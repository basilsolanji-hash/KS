@* Панель быстрого доступа рядом с профилем. Полный вид — закреплённые ярлыки, «Ещё», «Все инструменты», настройка и
   профиль; компактный (телефон, узкий планшет) — одна кнопка «Инструменты» с меню и значок профиля. *@

<div class="quickbar @(Compact ? "compact" : "")" @onkeydown="OnKeyDown">
    @if (!Compact)
    {
        @* Только значки; название — во всплывающей подсказке и для экранного диктора. Поиск — всегда первым, поддержка — последней. *@
        <div class="quick-pinned" role="toolbar" aria-label="@L("Быстрый доступ")">
            @RenderTool(ToolCatalog.Find(ToolCatalog.Search)!, asMenuItem: false)
            <span class="quick-sep" aria-hidden="true"></span>
            @foreach (var tool in Visible)
            {
                @RenderTool(tool, asMenuItem: false)
            }
            @if (More.Count > 0)
            {
                <div class="menu-anchor">
                    <button type="button" class="quick-btn" aria-haspopup="menu" aria-expanded="@Expanded("more")" @onclick="@(() => Toggle("more"))"
                            title="@L("Ещё")" aria-label="@L("Ещё")">
                        <Icon Name="more" />
                    </button>
                    @if (_menu == "more")
                    {
                        <div class="menu" role="menu" aria-label="@L("Ещё")">
                            @foreach (var tool in More)
                            {
                                @RenderTool(tool, asMenuItem: true)
                            }
                        </div>
                    }
                </div>
            }
            <div class="menu-anchor">
                <button type="button" class="quick-btn" aria-haspopup="menu" aria-expanded="@Expanded("all")" @onclick="@(() => Toggle("all"))"
                        title="@L("Все инструменты")" aria-label="@L("Все инструменты")">
                    <Icon Name="all" />
                </button>
                @if (_menu == "all")
                {
                    @RenderAllMenu()
                }
            </div>
            <button type="button" class="quick-btn" @onclick="@(() => Open(SettingsId))" title="@L("Настроить панель")" aria-label="@L("Настроить панель")">
                <Icon Name="settings" />
            </button>
        </div>
    }
    else
    {
        @RenderTool(ToolCatalog.Find(ToolCatalog.Search)!, asMenuItem: false)
        <div class="menu-anchor">
            <button type="button" class="quick-btn" aria-haspopup="menu" aria-expanded="@Expanded("all")" @onclick="@(() => Toggle("all"))"
                    title="@L("Инструменты")" aria-label="@L("Инструменты")">
                <Icon Name="all" />
                @if (Badge > 0)
                {
                    <span class="badge" aria-label="@L("Уведомлений: {0}", Badge)">@Badge</span>
                }
            </button>
            @if (_menu == "all")
            {
                @RenderAllMenu()
            }
        </div>
    }

    @if (ShowProfile)
    {
        <ProfileMenu Access="Access" OnOpen="Open" AvatarOnly="Compact" />
    }

    @if (_menu is not null)
    {
        @* Щелчок мимо меню закрывает его. *@
        <div class="menu-backdrop" @onclick="Close"></div>
    }
</div>

@code {
    public const string SettingsId = "settings";

    [Parameter, EditorRequired]
    public CurrentAccessDto Access { get; set; } = default!;

    [Parameter, EditorRequired]
    public PanelSettings Settings { get; set; } = default!;

    [Parameter]
    public bool Compact { get; set; }

    /// <summary>Профиль в строке инструментов — только на телефоне; на компьютере он внизу меню слева.</summary>
    [Parameter]
    public bool ShowProfile { get; set; } = true;

    [Parameter]
    public string? ActiveTool { get; set; }

    [Parameter]
    public int Badge { get; set; }

    [Parameter]
    public EventCallback<string> OnOpen { get; set; }

    /// <summary>Открытые отдельные окна инструментов (калькулятор) — их значок подсвечен.</summary>
    [Parameter]
    public IReadOnlyCollection<string> OpenWindows { get; set; } = [];

    private string? _menu;

    /// <summary>Подсказка значка: название и что делает; у поиска — сочетание клавиш.</summary>
    private static string Tip(ToolDefinition tool) =>
        tool.Id == ToolCatalog.Search ? $"{L(tool.Title)} (Ctrl+K)" : $"{L(tool.Title)} — {L(tool.Hint)}";

    /// <summary>Сайт организации показывается, только когда адрес задан в реквизитах организации.</summary>
    private IEnumerable<ToolDefinition> Available =>
        ToolCatalog.All.Where(t => t.Id != ToolCatalog.Site || Access.WebsiteUrl is not null);

    private List<ToolDefinition> Pinned =>
        Settings.Pinned.Select(ToolCatalog.Find).OfType<ToolDefinition>().Where(t => Available.Contains(t) && !ToolCatalog.Fixed.Contains(t.Id)).ToList();

    private List<ToolDefinition> Visible => Pinned.Take(Settings.Visible).ToList();

    private List<ToolDefinition> More => Pinned.Skip(Settings.Visible).ToList();

    private RenderFragment RenderTool(ToolDefinition tool, bool asMenuItem) => __builder =>
    {
        var active = ActiveTool == tool.Id || (tool.Mode == ToolOpenMode.Window && OpenWindows.Contains(tool.Id));
        var css = asMenuItem ? "menu-item" : $"quick-btn{(active ? " active" : "")}";
        var label = asMenuItem ? null : L(tool.Title);
        if (tool.Mode == ToolOpenMode.NewTab)
        {
            <a class="@css" href="@Access.WebsiteUrl" target="_blank" rel="noopener noreferrer" title="@Tip(tool)" aria-label="@label" role="@(asMenuItem ? "menuitem" : null)" @onclick="Close">
                <Icon Name="@tool.Id" />@if (asMenuItem) { <span class="quick-label">@L(tool.Title)</span> }
            </a>
        }
        else
        {
            <button type="button" class="@css" title="@Tip(tool)" aria-label="@label" role="@(asMenuItem ? "menuitem" : null)" aria-pressed="@(asMenuItem ? null : active ? "true" : "false")"
                    @onclick="@(() => Open(tool.Id))">
                <Icon Name="@tool.Id" />@if (asMenuItem) { <span class="quick-label">@L(tool.Title)</span> }
                @if (tool.Id == ToolCatalog.Notifications && Badge > 0)
                {
                    <span class="badge" aria-label="@L("новых: {0}", Badge)">@Badge</span>
                }
            </button>
        }
    };

    private RenderFragment RenderAllMenu() => __builder =>
    {
        <div class="menu menu-wide menu-right" role="menu" aria-label="@L("Все инструменты")">
            @if (Compact && Pinned.Count > 0)
            {
                <div class="menu-caption">@L("Закреплённые")</div>
                @foreach (var tool in Pinned)
                {
                    @RenderTool(tool, asMenuItem: true)
                }
                <div class="menu-caption">@L("Все инструменты")</div>
            }
            @foreach (var tool in Available.Where(t => (!Compact || !Pinned.Contains(t)) && (!Compact || t.Id != ToolCatalog.Search)))
            {
                @RenderTool(tool, asMenuItem: true)
            }
            @if (Access.WebsiteUrl is null)
            {
                <span class="menu-item disabled" title="@L("Адрес сайта задаёт Владелец в разделе «Организация»")">
                    <Icon Name="@ToolCatalog.Site" /><span class="quick-label">@L("Сайт организации — адрес не задан")</span>
                </span>
            }
            <button type="button" role="menuitem" class="menu-item" @onclick="@(() => Open(SettingsId))">
                <Icon Name="settings" /><span class="quick-label">@L("Настроить панель")</span>
            </button>
        </div>
    };

    private string Expanded(string menu) => _menu == menu ? "true" : "false";

    private void Toggle(string menu) => _menu = _menu == menu ? null : menu;

    private void Close() => _menu = null;

    private async Task Open(string id)
    {
        _menu = null;
        await OnOpen.InvokeAsync(id);
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            _menu = null;
        }
    }
}
