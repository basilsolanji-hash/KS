@inherits LayoutComponentBase
@implements IDisposable
@inject UserAccessService Access
@inject NavigationManager Navigation

<div class="shell">
    <nav class="side" aria-label="Разделы">
        <div class="side-head">
            <div class="logo">knit<span style="color: #2BA89A">ERP</span></div>
            @* На телефоне меню свёрнуто в кнопку, чтобы не занимать экран над страницей. *@
            <button type="button" class="secondary menu-toggle" aria-expanded="@(_menuOpen ? "true" : "false")" aria-controls="nav-body"
                    @onclick="() => _menuOpen = !_menuOpen">@(_menuOpen ? "Закрыть" : "Меню")</button>
        </div>
        <div id="nav-body" class="nav-body @(_menuOpen ? "open" : "")">
        @if (_access is not null)
        {
            @foreach (var item in Items)
            {
                @if (Sections.TryGetValue(item.Href, out var groupTitle))
                {
                    <div class="nav-section">@groupTitle</div>
                }
                <NavLink href="@item.Href" Match="@(item.Href == "" ? NavLinkMatch.All : NavLinkMatch.Prefix)">
                    @item.Label
                    @if (!item.Allowed(_access))
                    {
                        <span class="tag">нет доступа</span>
                    }
                </NavLink>
            }
            <div class="session">
                <div>@_access.DisplayName</div>
                <div class="muted">@string.Join(", ", _access.RoleNames) · @_access.OrganizationName</div>
                <a href="account/organizations" data-enhance-nav="false" style="padding: 6px 0">Сменить организацию</a>
                <form method="post" action="account/logout">
                    <AntiforgeryToken />
                    <button type="submit" class="link">Выйти</button>
                </form>
            </div>
        }
        </div>
    </nav>
    <main class="main">
        @if (_access is null)
        {
            <p class="muted">Загрузка…</p>
        }
        else
        {
            @* Страница начинает работу после меню: у вкладки один DbContext, параллельных запросов к нему быть не должно. *@
            <CascadingValue Value="_access" IsFixed="true">
                @Body
            </CascadingValue>
        }
    </main>
</div>

@code {
    private CurrentAccessDto? _access;

    // Пункты без доступа видны и кликабельны: сервер ответит отказом и запишет попытку в журнал.
    private static readonly (string Href, string Label, Func<CurrentAccessDto, bool> Allowed)[] Items =
    [
        ("", "Организация", a => a.Has(Permissions.OrganizationView)),
        ("structure", "Структура", a => a.Has(Permissions.DepartmentView)),
        ("employees", "Сотрудники", a => a.HasOwnOnly(Permissions.EmployeeView)),
        ("catalog", "Номенклатура", a => a.Has(Permissions.CatalogView)),
        ("warehouses", "Склады", a => a.Has(Permissions.CatalogView)),
        ("counterparties", "Контрагенты", a => a.Has(Permissions.CatalogView)),
        ("opening-balances", "Начальные остатки", a => a.Has(Permissions.OpeningBalanceCreate) || a.Has(Permissions.OpeningBalanceApprove)
                                                   || a.Has(Permissions.WarehouseReportView)),
        ("stock-documents", "Складские документы", a => a.Has(Permissions.WarehouseDocumentCreate) || a.Has(Permissions.WarehouseDocumentPost)
                                                     || a.Has(Permissions.WarehouseReportView)),
        ("inventory", "Инвентаризация", a => a.Has(Permissions.WarehouseDocumentCreate) || a.Has(Permissions.WarehouseDocumentPost)
                                          || a.Has(Permissions.WarehouseReportView)),
        ("stock", "Остатки", a => a.Has(Permissions.WarehouseReportView)),
        ("reports/movements", "Движения", a => a.Has(Permissions.WarehouseReportView)),
        ("reports/turnover", "Обороты", a => a.Has(Permissions.WarehouseReportView)),
        ("period", "Закрытие периода", a => a.Has(Permissions.ClosedPeriodReopen) || a.Has(Permissions.WarehouseReportView)),
        ("users", "Пользователи", a => a.Has(Permissions.UserView)),
        ("roles", "Роли и права", a => a.Has(Permissions.UserView)),
        ("audit", "Журнал аудита", a => a.HasOwnOnly(Permissions.AuditLogView)),
    ];

    /// <summary>Заголовки групп меню: ставятся перед пунктом с этим адресом.</summary>
    private static readonly Dictionary<string, string> Sections = new()
    {
        [""] = "Предприятие",
        ["catalog"] = "Справочники",
        ["opening-balances"] = "Склад",
        ["stock"] = "Отчёты",
        ["users"] = "Доступ",
    };

    private bool _menuOpen;

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += CloseMenu;
        _access = await Access.GetCurrentAccessAsync();
    }

    private void CloseMenu(object? sender, LocationChangedEventArgs e)
    {
        if (_menuOpen)
        {
            _menuOpen = false;
            _ = InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose() => Navigation.LocationChanged -= CloseMenu;
}
