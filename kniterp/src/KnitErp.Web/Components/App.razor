<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>knitERP</title>
    <style>
        :root { color-scheme: dark; }
        body { margin: 0; background: #1A1A1C; color: #ECECEE; font-family: system-ui, sans-serif; font-size: 15px; }
        a { color: #2BA89A; }
        .shell { display: flex; flex-wrap: wrap; min-height: 100vh; }
        .side { flex: 1 1 200px; padding: 16px; border-right: 1px solid #2E2E33; }
        .side a { display: block; padding: 10px 12px; text-decoration: none; color: #C8C8CE; border-radius: 6px; }
        .side a.active { background: #22302E; color: #ECECEE; }
        .session { margin: 24px 12px 0; padding-top: 16px; border-top: 1px solid #2E2E33; font-size: 13px; }
        .main { flex: 999 1 600px; min-width: 0; padding: 24px; }
        table { border-collapse: collapse; width: 100%; }
        th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid #2E2E33; }
        .muted { color: #A6A6AE; }
        .error { border: 1px solid #5A2E2E; background: #2C1A1A; padding: 12px; border-radius: 8px; }
        .card { max-width: 420px; margin: 10vh auto; padding: 0 16px; }
        .card form { display: flex; flex-direction: column; gap: 12px; margin-top: 16px; }
        .card label { display: flex; flex-direction: column; gap: 6px; color: #C8C8CE; }
        input { font: inherit; padding: 10px 12px; border-radius: 6px; border: 1px solid #3A3A40; background: #232326; color: #ECECEE; }
        button { font: inherit; padding: 10px 14px; border-radius: 6px; border: 0; background: #2BA89A; color: #0E1413; font-weight: 600; cursor: pointer; }
        button.link { background: none; color: #2BA89A; padding: 0; font-weight: 400; }
        .key { font-family: ui-monospace, monospace; letter-spacing: 1px; word-break: break-all; }
        .qr { background: #fff; padding: 12px; border-radius: 8px; width: 200px; height: 200px; }
        h2 { font-size: 18px; margin: 0 0 8px; }
        .page-head { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; justify-content: space-between; }
        .scroll { overflow-x: auto; }
        .tag { display: inline-block; font-size: 12px; padding: 2px 8px; border-radius: 999px; background: #2E2E33; color: #C8C8CE; margin-left: 6px; }
        .tag.ok { background: #1E3A35; color: #8FE0D3; margin-left: 0; }
        .tag.warn { background: #3D341C; color: #F0CF7A; margin-left: 0; }
        .tag.bad { background: #43231F; color: #F2A79C; margin-left: 0; }
        .panel { border: 1px solid #2E2E33; background: #202023; border-radius: 10px; padding: 16px; margin: 16px 0; }
        .panel form, .panel .grid { display: flex; flex-direction: column; gap: 12px; }
        .panel label { display: flex; flex-direction: column; gap: 6px; color: #C8C8CE; }
        @@media (min-width: 900px) { .panel .grid { display: grid; grid-template-columns: 1fr 1fr; } }
        select { font: inherit; padding: 10px 12px; border-radius: 6px; border: 1px solid #3A3A40; background: #232326; color: #ECECEE; }
        button.secondary { background: #2E2E33; color: #ECECEE; font-weight: 400; }
        button:disabled { opacity: .5; cursor: default; }
        .actions, .row-actions { display: flex; flex-wrap: wrap; gap: 8px; }
        .row-actions button { padding: 6px 10px; font-size: 13px; }
        .diff { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; }
        .diff > div { display: flex; flex-wrap: wrap; gap: 6px; align-content: flex-start; }
        .diff > div > .muted { width: 100%; }
        .chip { font-size: 13px; padding: 4px 10px; border-radius: 6px; background: #2E2E33; }
        .chip.added { background: #1E3A35; color: #CDEFE9; }
        .lang-row { display: flex; flex-wrap: wrap; gap: 6px; padding: 2px 10px 8px; }
        .lang-row .chip { border: 0; color: #ECECEE; font-weight: 400; cursor: pointer; min-height: 32px; }
        .lang-row .chip.added { color: #CDEFE9; }
        .lang-links { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 20px; font-size: 14px; }
        .flash { display: flex; justify-content: space-between; gap: 12px; align-items: center; border: 1px solid #2B5E56; background: #1A2B28; padding: 10px 14px; border-radius: 8px; margin: 12px 0; }
        a.button { display: inline-block; padding: 10px 14px; border-radius: 6px; background: #2BA89A; color: #0E1413; font-weight: 600; text-decoration: none; }
        a.button.secondary { background: #2E2E33; color: #ECECEE; font-weight: 400; }
        details.panel > summary { cursor: pointer; font-weight: 600; }
        .totals { display: flex; flex-wrap: wrap; gap: 16px; margin: 12px 0; }
        .totals .bad { color: #F2A79C; }
        .codes { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 8px 24px; padding-left: 24px; font-size: 18px; }
        .checklist { list-style: none; padding: 0; margin: 16px 0; display: flex; flex-direction: column; gap: 8px; }
        .checklist li { display: flex; gap: 12px; align-items: center; border: 1px solid #2E2E33; background: #202023; border-radius: 10px; padding: 12px 14px; }
        .checklist li > div { flex: 1; min-width: 0; }
        .checklist .mark { flex: none; width: 28px; height: 28px; border-radius: 50%; display: grid; place-items: center; font-weight: 700; background: #2E2E33; }
        .checklist .done .mark { background: #1E3A35; color: #8FE0D3; }
        .checklist .todo { border-color: #5A2E2E; }
        .checklist .todo .mark { background: #43231F; color: #F2A79C; }
        .checklist .manual .mark { background: #3D341C; color: #F0CF7A; }
        .flash.error { border-color: #5A2E2E; background: #2C1A1A; }
        .denied { border: 1px solid #5A2E2E; background: #2C1A1A; padding: 20px; border-radius: 10px; }
        .denied h1 { font-size: 22px; margin: 8px 0; }
        .denied-code { font-weight: 700; color: #F2A79C; }
        .legend { display: flex; flex-wrap: wrap; gap: 16px; margin: 12px 0; color: #C8C8CE; }
        .matrix th.mine, .matrix td.mine { background: #1E3A35; }
        .inline-form { display: flex; flex-wrap: wrap; gap: 8px 12px; align-items: flex-end; margin: 12px 0; }
        .inline-form label { display: flex; flex-direction: column; gap: 6px; color: #C8C8CE; }
        label.inline { display: inline-flex; flex-direction: row; gap: 8px; align-items: center; color: #C8C8CE; }
        tr.archived td { color: #8A8A92; }
        .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
        .matrix td:not(:first-child), .matrix th:not(:first-child) { text-align: center; }
        .side-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin: 4px 12px 16px; }
        .logo { font-weight: 600; font-size: 18px; }
        .menu-toggle { display: none; }
        .nav-section { margin: 14px 12px 4px; font-size: 12px; text-transform: uppercase; letter-spacing: .06em; color: #8A8A92; }
        .side a { padding-top: 7px; padding-bottom: 7px; }
        .num { text-align: right; white-space: nowrap; }
        tr.short td { color: #F2A79C; }
        dl.facts { display: grid; grid-template-columns: max-content 1fr; gap: 8px 16px; margin: 12px 0; max-width: 720px; }
        dl.facts dt { color: #A6A6AE; }
        dl.facts dd { margin: 0; overflow-wrap: anywhere; }

        /* Планшет и телефон: меню сворачивается в кнопку и прилипает к верху, страница получает всю ширину. */
        @@media (max-width: 899px) {
            .shell { flex-direction: column; flex-wrap: nowrap; }
            .side { flex: none; position: sticky; top: 0; z-index: 10; background: #1A1A1C; border-right: 0; border-bottom: 1px solid #2E2E33; padding: 8px 12px; }
            .side-head { margin: 0; }
            .menu-toggle { display: inline-block; }
            .nav-body { display: none; max-height: calc(100vh - 64px); overflow-y: auto; padding-top: 8px; }
            .nav-body.open { display: block; }
            .main { flex: 1 1 auto; padding: 16px 12px; }
            h1 { font-size: 22px; }
        }

        /* Телефон: поля и кнопки во всю ширину и не мельче 16px (iOS не увеличивает страницу при вводе). */
        @@media (max-width: 599px) {
            body { font-size: 16px; }
            input, select, button, a.button { font-size: 16px; min-height: 44px; box-sizing: border-box; }
            .inline-form { flex-direction: column; align-items: stretch; }
            .inline-form label, .inline-form input, .inline-form select { width: 100%; }
            .inline-form input[size] { width: 100%; }
            input[type=checkbox], .inline-form input[type=checkbox] { width: 22px; height: 22px; min-height: 0; flex: none; }
            .actions > *, .page-head > button, .page-head > a.button { flex: 1 1 100%; text-align: center; }
            .row-actions button { min-height: 40px; }
            dl.facts { grid-template-columns: 1fr; gap: 2px; }
            dl.facts dd { margin-bottom: 8px; }
            .card { margin: 4vh auto; }

            /* Таблицы-списки становятся карточками: подпись столбца берётся из заголовка таблицы (скрипт ниже). */
            .scroll table:not(.matrix) thead { display: none; }
            .scroll table:not(.matrix), .scroll table:not(.matrix) tbody { display: block; }
            .scroll table:not(.matrix) tr { display: block; border: 1px solid #2E2E33; border-radius: 10px; padding: 6px 12px; margin-bottom: 10px; background: #202023; }
            .scroll table:not(.matrix) td { display: flex; justify-content: space-between; gap: 12px; border: 0; padding: 6px 0; text-align: right; overflow-wrap: anywhere; }
            .scroll table:not(.matrix) td[data-label]::before { content: attr(data-label); color: #A6A6AE; text-align: left; flex: 0 0 40%; }
            .scroll table:not(.matrix) td:not([data-label]) { justify-content: flex-start; text-align: left; }
            .scroll table:not(.matrix) td:empty { display: none; }
            /* Приоритетные столбцы: второстепенные (th.opt) скрыты, строка раскрывается по нажатию «Подробнее». */
            .scroll table:not(.matrix) td[data-opt] { display: none; }
            .scroll table:not(.matrix) tr[data-open] td[data-opt] { display: flex; }
            .scroll table:not(.matrix) tr[data-has-opt] { cursor: pointer; }
            .scroll table:not(.matrix) tr[data-has-opt]::after { content: "Подробнее ▾"; display: block; padding-top: 6px; color: #2BA89A; font-size: 14px; }
            .scroll table:not(.matrix) tr[data-has-opt][data-open]::after { content: "Свернуть ▴"; }
        }

        /* Колонка страницы: панель быстрого доступа сверху, затем содержимое. */
        .main-col { flex: 999 1 600px; min-width: 0; display: flex; flex-direction: column; }
        .main-col > .main { flex: 1 1 auto; }
        .topbar { position: sticky; top: 0; z-index: 20; display: flex; justify-content: flex-end; align-items: center; box-sizing: border-box; height: 57px; padding: 0 24px; border-bottom: 1px solid #2E2E33; background: #1A1A1C; }
        .quickbar { display: flex; align-items: center; gap: 6px; flex-wrap: nowrap; }
        .quick-pinned { display: flex; align-items: center; gap: 4px; flex-wrap: wrap; justify-content: flex-end; }
        .quick-btn { display: inline-flex; align-items: center; gap: 6px; min-height: 40px; min-width: 40px; padding: 6px 10px; border-radius: 8px;
                     background: transparent; color: #C8C8CE; font-weight: 400; border: 1px solid transparent; text-decoration: none; position: relative; }
        .quick-btn:hover, .quick-btn.active { background: #22302E; color: #ECECEE; }
        .tool-icon { font-size: 17px; line-height: 1; width: 1.2em; text-align: center; }
        .quick-btn .quick-label { font-size: 14px; }
        @@media (max-width: 1399px) {
            .quick-pinned .quick-btn .quick-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
            .quick-pinned > .quick-btn .badge { position: absolute; top: 1px; right: -2px; }
        }
        .badge { display: inline-block; min-width: 18px; padding: 0 5px; border-radius: 999px; background: #F0CF7A; color: #1A1A1C; font-size: 11px; font-weight: 700; line-height: 18px; text-align: center; }
        .icon-svg { flex: none; display: block; }
        .menu .badge { margin-left: auto; }
        .profile { display: inline-flex; align-items: center; gap: 10px; background: transparent; color: #ECECEE; padding: 4px 8px; font-weight: 400; border-left: 1px solid #2E2E33; border-radius: 0; margin-left: 6px; text-align: left; }
        .avatar { display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 50%; background: #1E3A35; color: #8FE0D3; font-weight: 700; font-size: 14px; flex: none; }
        .profile-text { display: flex; flex-direction: column; line-height: 1.25; max-width: 220px; }
        .profile-name { font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .profile-sub { font-size: 12px; color: #A6A6AE; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .menu-anchor { position: relative; }
        .menu { position: absolute; top: calc(100% + 6px); left: 0; z-index: 70; min-width: 240px; max-height: 70vh; overflow-y: auto; padding: 6px; border-radius: 10px;
                background: #202023; border: 1px solid #3A3A40; box-shadow: 0 12px 32px rgba(0,0,0,.45); display: flex; flex-direction: column; }
        .menu-right { left: auto; right: 0; }
        .menu-wide { min-width: 280px; }
        .menu .menu-item, .menu a[role=menuitem] { display: flex; align-items: center; gap: 10px; width: 100%; min-height: 40px; padding: 8px 10px; border-radius: 6px;
                background: transparent; color: #ECECEE; font-weight: 400; text-decoration: none; text-align: left; box-sizing: border-box; }
        .menu .menu-item:hover, .menu a[role=menuitem]:hover { background: #22302E; }
        .menu .menu-item.disabled { color: #8A8A92; cursor: default; }
        .menu .menu-item.disabled:hover { background: transparent; }
        .menu .quick-label { position: static !important; width: auto !important; height: auto !important; clip: auto !important; }
        .menu-caption { font-size: 12px; text-transform: uppercase; letter-spacing: .06em; color: #8A8A92; padding: 8px 10px 4px; }
        .menu-info { display: flex; flex-direction: column; gap: 2px; padding: 8px 10px 10px; border-bottom: 1px solid #2E2E33; margin-bottom: 4px; }
        .menu form { margin: 0; }
        .menu-backdrop { position: fixed; inset: 0; z-index: 65; }
        .quickbar .menu-anchor { z-index: 66; }
        .side-tools { display: none; }

        /* Панель инструмента. */
        .drawer { position: fixed; top: 57px; right: 0; bottom: 0; z-index: 50; width: min(440px, 100vw); display: flex; flex-direction: column;
                  background: #1E1E21; border-left: 1px solid #3A3A40; box-shadow: -12px 0 32px rgba(0,0,0,.4);
                  transform: translateX(105%); transition: transform .18s ease-out; visibility: hidden; }
        .drawer.open { transform: none; visibility: visible; }
        @@media (prefers-reduced-motion: reduce) { .drawer { transition: none; } }
        .drawer-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 16px; border-bottom: 1px solid #2E2E33; }
        .drawer-head h2 { margin: 0; font-size: 18px; }
        .drawer-body { flex: 1 1 auto; overflow-y: auto; padding: 16px; overscroll-behavior: contain; }
        .drawer-body h3 { font-size: 15px; margin: 18px 0 8px; }
        button.icon { min-width: 40px; min-height: 40px; padding: 6px 10px; }
        .tool-form { display: flex; flex-direction: column; gap: 10px; margin: 0 0 12px; }
        .tool-form label { display: flex; flex-direction: column; gap: 6px; color: #C8C8CE; }
        .tool-form label.inline { flex-direction: row; }
        .tool-row { display: flex; gap: 10px; flex-wrap: wrap; align-items: flex-end; }
        .tool-row label { flex: 1 1 120px; }
        textarea { font: inherit; padding: 10px 12px; border-radius: 6px; border: 1px solid #3A3A40; background: #232326; color: #ECECEE; resize: vertical; }
        ul.plain { list-style: none; padding: 0; margin: 0 0 12px; }
        .link-list li { display: flex; justify-content: space-between; align-items: center; gap: 10px; padding: 6px 0; border-bottom: 1px solid #2A2A2E; flex-wrap: wrap; }
        .calc-keys { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; }
        .calc-keys button { min-height: 48px; font-size: 18px; }
        .calc-result { display: flex; flex-wrap: wrap; align-items: baseline; gap: 10px; padding: 12px; margin: 12px 0; border-radius: 8px; background: #1A2B28; }
        .calc-result b { font-size: 24px; }
        .cal-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; text-transform: capitalize; }
        .cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; }
        .cal-dow { text-align: center; font-size: 12px; color: #8A8A92; }
        .cal-day { position: relative; min-height: 40px; padding: 4px; border-radius: 6px; background: #232326; color: #ECECEE; font-weight: 400; }
        .cal-day.other { color: #6A6A72; }
        .cal-day.today { border: 1px solid #2BA89A; }
        .cal-day.selected { background: #2BA89A; color: #0E1413; font-weight: 700; }
        .cal-dot { position: absolute; bottom: 4px; left: 50%; width: 5px; height: 5px; margin-left: -2px; border-radius: 50%; background: #F0CF7A; }
        .task-list { list-style: none; padding: 0; margin: 0 0 12px; }
        .task-list li { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 10px; padding: 8px 0; border-bottom: 1px solid #2A2A2E; }
        .task-list li > label { flex: 1 1 60%; }
        .task-list li.done span:first-of-type { text-decoration: line-through; color: #8A8A92; }
        .tabs { display: flex; gap: 6px; margin-bottom: 12px; }
        .note-list { list-style: none; padding: 0; }
        .note-list li { padding: 10px 0; border-bottom: 1px solid #2A2A2E; }
        .note-text { white-space: pre-wrap; overflow-wrap: anywhere; margin-bottom: 6px; }
        .notice { padding: 10px 12px; border-radius: 8px; background: #232326; margin-bottom: 8px; border-left: 3px solid #3A3A40; }
        .notice.action { border-left-color: #2BA89A; }
        .notice.warning { border-left-color: #F0CF7A; }
        .notice button.link { text-align: left; color: #ECECEE; }
        .chat { display: flex; flex-direction: column; gap: 8px; margin: 12px 0; }
        .chat-msg { max-width: 92%; padding: 10px 12px; border-radius: 10px; }
        .chat-msg.user { align-self: flex-end; background: #1E3A35; }
        .chat-msg.bot { align-self: flex-start; background: #232326; }
        .chat-text { white-space: pre-wrap; overflow-wrap: anywhere; }
        .chat-links { display: flex; flex-direction: column; gap: 4px; margin-top: 8px; }
        .weather { padding: 14px; border-radius: 10px; background: #232326; margin: 12px 0; }
        .weather-temp { font-size: 32px; font-weight: 700; }
        .ticket { padding: 10px 0; border-bottom: 1px solid #2A2A2E; display: flex; flex-direction: column; gap: 4px; }
        .ticket-text, .ticket-answer { white-space: pre-wrap; overflow-wrap: anywhere; }
        .ticket-answer { padding: 8px 10px; border-radius: 6px; background: #1A2B28; }
        .pin-list { padding: 0; list-style: none; margin: 0 0 12px; }
        .pin-list li { display: flex; align-items: center; gap: 6px; padding: 6px 0; border-bottom: 1px solid #2A2A2E; }
        .pin-list li.pin-more .pin-title { color: #A6A6AE; }
        .pin-icon { width: 28px; display: inline-flex; justify-content: center; }
        .pin-title { flex: 1 1 auto; min-width: 0; }
        .help-article p, .help-current p { line-height: 1.5; }

        /* Клавиатура: видимый фокус на всех элементах управления. */
        :focus-visible { outline: 2px solid #2BA89A; outline-offset: 2px; }
        /* Сенсорный экран: цели не меньше 44 px. */
        @@media (pointer: coarse) { button, a.button, select, input:not([type=checkbox]), .quick-btn, .side a { min-height: 44px; } }
        /* Большие мониторы: крупнее шрифт и поля, таблицы во всю ширину. */
        @@media (min-width: 1600px) { body { font-size: 16px; } .main { padding: 28px 40px; } .topbar { padding: 0 40px; } }

        @@media (max-width: 899px) {
            .topbar { display: none; }
            .side-head { gap: 8px; }
            .side-head .logo { flex: 1 1 auto; }
            .side-tools { display: block; }
            .quickbar.compact .profile { border-left: 0; margin-left: 0; padding: 2px; }
            .quickbar.compact .quick-btn { border: 1px solid #3A3A40; }
            .drawer { top: auto; left: 0; width: 100vw; z-index: 80; height: 88vh; height: 88dvh; border-left: 0; border-top: 1px solid #3A3A40; border-radius: 14px 14px 0 0;
                      transform: translateY(105%); box-shadow: 0 -12px 32px rgba(0,0,0,.45); }
            .drawer.open { transform: none; }
        }
        @@media (max-width: 420px) { .quickbar.compact .quick-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); } }
        /* Телефон боком: мало высоты — меню не прилипает, шторка во всю высоту. */
        @@media (max-height: 500px) and (orientation: landscape) {
            .side { position: static; }
            .drawer { height: 100vh; height: 100dvh; border-radius: 0; }
        }
    </style>
    <HeadOutlet @rendermode="PageRenderMode" />
</head>
<body>
    <Routes @rendermode="PageRenderMode" />
    <script src="_framework/blazor.web.js"></script>
    <script src="js/kniterp.js"></script>
</body>
</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // Страницы входа работают без интерактивности: cookie выдаётся только в обычном HTTP-ответе.
    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}
