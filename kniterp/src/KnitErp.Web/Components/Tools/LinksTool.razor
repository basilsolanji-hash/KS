@inject PersonalToolsService Personal

@if (_error is not null)
{
    <div class="error" role="alert">@_error</div>
}

@if (_links is null)
{
    <p class="muted">@L("Загрузка…")</p>
}
else
{
    @if (_links.Count == 0)
    {
        <p class="muted">@L("Своих ссылок пока нет: добавьте сайт поставщика, таблицу или инструкцию.")</p>
    }
    <ul class="plain link-list">
        @foreach (var l in _links)
        {
            <li>
                <a href="@l.Url" target="_blank" rel="noopener noreferrer" title="@l.Url">@l.Title ↗</a>
                <button type="button" class="link" @onclick="() => DeleteAsync(l)" aria-label="@L("Удалить ссылку {0}", l.Title)">@L("Удалить")</button>
            </li>
        }
    </ul>
    <form class="tool-form" @onsubmit="AddAsync">
        <h3>@L("Новая ссылка")</h3>
        <label>@L("Название") <input @bind="_title" maxlength="200" placeholder="@L("Необязательно")" /></label>
        <label>@L("Адрес") <input @bind="_url" maxlength="300" inputmode="url" placeholder="https://…" required /></label>
        <button type="submit" disabled="@_busy">@L("Добавить")</button>
    </form>
}

@code {
    private IReadOnlyList<LinkItem>? _links;
    private string _title = string.Empty;
    private string _url = string.Empty;
    private string? _error;
    private bool _busy;

    protected override Task OnInitializedAsync() => RunAsync(async () => _links = await Personal.GetLinksAsync());

    private Task AddAsync() => RunAsync(async () =>
    {
        _links = await Personal.AddLinkAsync(_title, _url);
        _title = string.Empty;
        _url = string.Empty;
    });

    private Task DeleteAsync(LinkItem l) => RunAsync(async () => _links = await Personal.DeleteLinkAsync(l.Id));

    private async Task RunAsync(Func<Task> action)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            await action();
        }
        catch (Exception ex) when (UiErrors.IsUserFacing(ex))
        {
            _error = UiErrors.Message(ex);
        }
        finally
        {
            _busy = false;
        }
    }
}
