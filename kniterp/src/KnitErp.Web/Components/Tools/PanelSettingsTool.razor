@* Настройка панели: какие ярлыки закреплены, их порядок и сколько видно сразу. Хранится в профиле пользователя. *@

<p class="muted">Закреплённые ярлыки показываются рядом с профилем по порядку. Первые @_visible видно сразу, остальные — в меню «Ещё». На телефоне все ярлыки — в одном меню «Инструменты».</p>

<h3>Закреплённые</h3>
@if (_pinned.Count == 0)
{
    <p class="muted">Ничего не закреплено — инструменты доступны через «Все инструменты».</p>
}
<ol class="pin-list">
    @for (var i = 0; i < _pinned.Count; i++)
    {
        var index = i;
        var tool = ToolCatalog.Find(_pinned[index])!;
        <li class="@(index < _visible ? "" : "pin-more")">
            <span class="pin-icon"><Icon Name="@tool.Id" /></span>
            <span class="pin-title">@tool.Title @if (index >= _visible) { <span class="tag">в «Ещё»</span> }</span>
            <button type="button" class="secondary icon" @onclick="() => Move(index, -1)" disabled="@(index == 0)" aria-label="Выше: @tool.Title" title="Выше">↑</button>
            <button type="button" class="secondary icon" @onclick="() => Move(index, 1)" disabled="@(index == _pinned.Count - 1)" aria-label="Ниже: @tool.Title" title="Ниже">↓</button>
            <button type="button" class="secondary icon" @onclick="() => _pinned.RemoveAt(index)" aria-label="Открепить: @tool.Title" title="Открепить">✕</button>
        </li>
    }
</ol>

<label class="tool-row">
    Видно сразу
    <input type="number" min="0" max="@ToolCatalog.MaxVisible" @bind="_visible" style="width: 6em" />
</label>

<h3>Можно добавить</h3>
<ul class="plain pin-list">
    @foreach (var tool in ToolCatalog.All.Where(t => !_pinned.Contains(t.Id)))
    {
        <li>
            <span class="pin-icon"><Icon Name="@tool.Id" /></span>
            <span class="pin-title">@tool.Title <span class="muted">— @tool.Hint</span></span>
            <button type="button" class="secondary icon" @onclick="() => _pinned.Add(tool.Id)" aria-label="Закрепить: @tool.Title" title="Закрепить">+</button>
        </li>
    }
</ul>

@if (_message is not null)
{
    <div class="@(_isError ? "flash error" : "flash")" role="status">@_message</div>
}
<div class="actions">
    <button type="button" @onclick="SaveAsync" disabled="@_busy">Сохранить</button>
    <button type="button" class="secondary" @onclick="Reset" disabled="@_busy">Как было по умолчанию</button>
</div>

@code {
    [Parameter, EditorRequired]
    public PanelSettings Settings { get; set; } = default!;

    [Parameter]
    public EventCallback<PanelSettings> OnSave { get; set; }

    private List<string> _pinned = [];
    private int _visible;
    private string? _message;
    private bool _isError;
    private bool _busy;
    private PanelSettings? _loaded;

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_loaded, Settings))
        {
            _pinned = Settings.Pinned.ToList();
            _visible = Settings.Visible;
            _loaded = Settings;
        }
    }

    private void Move(int index, int delta)
    {
        var target = index + delta;
        (_pinned[index], _pinned[target]) = (_pinned[target], _pinned[index]);
    }

    private void Reset()
    {
        _pinned = ToolCatalog.DefaultPinned.ToList();
        _visible = ToolCatalog.DefaultVisible;
    }

    private async Task SaveAsync()
    {
        _busy = true;
        try
        {
            await OnSave.InvokeAsync(new PanelSettings(_pinned.ToList(), _visible));
            _message = "Панель сохранена — она будет такой же на других устройствах.";
            _isError = false;
        }
        catch (Exception ex) when (UiErrors.IsUserFacing(ex))
        {
            _message = UiErrors.Message(ex);
            _isError = true;
        }
        finally
        {
            _busy = false;
        }
    }
}
