@using System.Globalization
@inject PersonalToolsService Personal

@* Календарь и задачи — один модуль с общими данными: задача с датой видна в календаре, без даты — только в списке. *@

@if (_error is not null)
{
    <div class="error" role="alert">@_error</div>
}

@if (_items is null)
{
    <p class="muted">@L("Загрузка…")</p>
}
else if (CalendarView)
{
    <div class="cal-head">
        <button type="button" class="secondary" @onclick="() => Shift(-1)" aria-label="@L("Предыдущий месяц")">‹</button>
        <b>@_month.ToString("MMMM yyyy", Ru)</b>
        <button type="button" class="secondary" @onclick="() => Shift(1)" aria-label="@L("Следующий месяц")">›</button>
    </div>
    <div class="cal-grid" role="grid" aria-label="@L("Календарь")">
        @foreach (var d in new[] { L("Пн"), L("Вт"), L("Ср"), L("Чт"), L("Пт"), L("Сб"), L("Вс") })
        {
            <div class="cal-dow" role="columnheader">@d</div>
        }
        @foreach (var day in MonthDays())
        {
            var count = _items.Count(t => t.Date == day && !t.Done);
            var holiday = _events.FirstOrDefault(e => e.Date == day && e.Kind == CalendarEventKind.Holiday);
            var birthdays = _events.Count(e => e.Date == day && e.Kind == CalendarEventKind.Birthday);
            <button type="button" role="gridcell"
                    class="cal-day @(day.Month != _month.Month ? "other" : "") @(day == _today ? "today" : "") @(day == _selected ? "selected" : "") @(holiday is not null ? "holiday" : "")"
                    title="@(holiday is null ? null : Holiday(holiday.Title))"
                    aria-label="@($"{day.ToString("d MMMM", Ru)}{(holiday is not null ? ", " + Holiday(holiday.Title) : "")}{(count > 0 ? ", " + L("дел: {0}", count) : "")}{(birthdays > 0 ? ", " + L("дней рождения: {0}", birthdays) : "")}")"
                    aria-pressed="@(day == _selected ? "true" : "false")" @onclick="() => _selected = day">
                @day.Day
                @if (count > 0)
                {
                    <span class="cal-dot" aria-hidden="true"></span>
                }
                @if (birthdays > 0)
                {
                    <span class="cal-dot bday" aria-hidden="true"></span>
                }
            </button>
        }
    </div>
    <h3>@_selected.ToString("dddd, d MMMM", Ru)</h3>
    @foreach (var e in _events.Where(e => e.Date == _selected))
    {
        <p class="cal-event @(e.Kind == CalendarEventKind.Holiday ? "holiday" : "bday")">
            @(e.Kind == CalendarEventKind.Holiday ? Holiday(e.Title) : L("День рождения: {0}", e.Title))
        </p>
    }
    @RenderList(_items.Where(t => t.Date == _selected).OrderBy(t => t.Time).ToList(), L("На этот день ничего нет."))
}
else
{
    <div class="tabs" role="tablist">
        <button type="button" role="tab" aria-selected="@(!_showDone ? "true" : "false")" class="@(!_showDone ? "" : "secondary")" @onclick="() => _showDone = false">@L("Активные")</button>
        <button type="button" role="tab" aria-selected="@(_showDone ? "true" : "false")" class="@(_showDone ? "" : "secondary")" @onclick="() => _showDone = true">@L("Выполненные")</button>
    </div>
    @RenderList(_items.Where(t => t.Done == _showDone).OrderBy(t => t.Date ?? DateOnly.MaxValue).ThenBy(t => t.Time).ToList(),
        _showDone ? L("Выполненных задач нет.") : L("Задач нет — добавьте первую."))
}

@if (_items is not null)
{
    <form class="tool-form" @onsubmit="SaveAsync">
        <h3>@(_editId is not null ? L("Правка задачи") : CalendarView ? L("Новое событие") : L("Новая задача"))</h3>
        <label>@L("Что сделать") <input @bind="_title" maxlength="200" required /></label>
        <div class="tool-row">
            @if (!CalendarView || _editId is not null)
            {
                <label>@L("Дата") <input type="date" @bind="_date" /></label>
            }
            <label>@L("Время") <input type="time" @bind="_time" /></label>
        </div>
        <label>@L("Описание") <textarea @bind="_note" rows="2" maxlength="5000"></textarea></label>
        <label class="inline"><input type="checkbox" @bind="_remind" /> @L("Напомнить в уведомлениях")</label>
        <div class="actions">
            <button type="submit" disabled="@_busy">@(_editId is not null ? L("Сохранить") : L("Добавить"))</button>
            @if (_editId is not null)
            {
                <button type="button" class="secondary" @onclick="ResetForm">@L("Отмена")</button>
            }
        </div>
    </form>

    @if (CalendarView)
    {
        <details class="tool-form">
            <summary>@L("Что показывать в календаре")</summary>
            <label class="inline"><input type="checkbox" checked="@_settings.ShowHolidays" @onchange='e => SaveSettingsAsync(_settings with { ShowHolidays = e.Value is true })' disabled="@_busy" /> @L("Праздники (ст. 112 ТК РФ)")</label>
            <label class="inline"><input type="checkbox" checked="@_settings.ShowBirthdays" @onchange='e => SaveSettingsAsync(_settings with { ShowBirthdays = e.Value is true })' disabled="@_busy" /> @L("Дни рождения коллег")</label>
            <p class="muted small">@L("Переносы выходных по постановлению Правительства не показываются. День рождения виден, только если сотрудник дал согласие — его отмечают в карточке сотрудника.")</p>
        </details>
    }
}

@code {
    // Названия месяцев и дней — на языке интерфейса (D60).
    private static CultureInfo Ru => CultureInfo.CurrentUICulture;

    [Parameter, EditorRequired]
    public ToolContext Context { get; set; } = default!;

    /// <summary>true — вид «Календарь», false — вид «Задачи».</summary>
    [Parameter]
    public bool CalendarView { get; set; }

    /// <summary>Инструмент снова на экране — данные могли измениться в соседнем виде (календарь ↔ задачи).</summary>
    [Parameter]
    public bool Active { get; set; }

    private bool _wasActive;

    private IReadOnlyList<TaskItem>? _items;
    private DateOnly _today;
    private DateOnly _month;
    private DateOnly _selected;
    private bool _showDone;
    private bool _busy;
    private string? _error;
    private string _title = string.Empty;
    private DateTime? _date;
    private TimeOnly? _time;
    private bool _remind;
    private string? _note;
    private string? _editId;
    private IReadOnlyList<CalendarEventDto> _events = [];
    private CalendarSettings _settings = new();

    protected override async Task OnInitializedAsync()
    {
        _today = PersonalToolsService.Today(DateTime.UtcNow, Context.Access.TimeZoneId);
        _selected = _today;
        _month = new DateOnly(_today.Year, _today.Month, 1);
        _date = CalendarView ? _today.ToDateTime(TimeOnly.MinValue) : null;
        await RunAsync(LoadAsync);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Active && !_wasActive && _items is not null)
        {
            await RunAsync(LoadAsync);
        }

        _wasActive = Active;
    }

    private RenderFragment RenderList(IReadOnlyList<TaskItem> list, string empty) => __builder =>
    {
        if (list.Count == 0)
        {
            <p class="muted">@empty</p>
            return;
        }

        <ul class="task-list">
            @foreach (var t in list)
            {
                <li class="@(t.Done ? "done" : "")">
                    <label class="inline">
                        <input type="checkbox" checked="@t.Done" disabled="@_busy" @onchange="e => SetDoneAsync(t, e.Value is true)" aria-label="@L("Выполнено: {0}", t.Title)" />
                        <span>@t.Title</span>
                    </label>
                    <span class="muted">
                        @(t.Date is { } d ? d.ToString("d MMM", Ru) : "")@(t.Time is { } tm ? " " + tm.ToString("HH:mm") : "")@(t.Remind ? " · " + L("напомнить") : "")
                    </span>
                    @if (t.Note is not null)
                    {
                        <span class="muted task-note">@t.Note</span>
                    }
                    <button type="button" class="link" @onclick="() => Edit(t)" aria-label="@L("Изменить: {0}", t.Title)">@L("Изменить")</button>
                    <ConfirmButton Class="link" OnConfirm="() => DeleteAsync(t)" AriaLabel="@L("Удалить: {0}", t.Title)" Question='@L("Удалить?")'>@L("Удалить")</ConfirmButton>
                </li>
            }
        </ul>
    };

    private IEnumerable<DateOnly> MonthDays()
    {
        var start = _month.AddDays(-(((int)_month.DayOfWeek + 6) % 7));
        for (var i = 0; i < 42; i++)
        {
            yield return start.AddDays(i);
        }
    }

    /// <summary>Название праздника на языке интерфейса (ProductionCalendar хранит русские названия ст. 112 ТК РФ).</summary>
    private static string Holiday(string name) => name switch
    {
        "Новогодние каникулы" => L("Новогодние каникулы"),
        "Рождество Христово" => L("Рождество Христово"),
        "День защитника Отечества" => L("День защитника Отечества"),
        "Международный женский день" => L("Международный женский день"),
        "Праздник Весны и Труда" => L("Праздник Весны и Труда"),
        "День Победы" => L("День Победы"),
        "День России" => L("День России"),
        "День народного единства" => L("День народного единства"),
        _ => name,
    };

    /// <summary>Задачи и, для календаря, праздники и дни рождения видимого месяца.</summary>
    private async Task LoadAsync()
    {
        _items = await Personal.GetTasksAsync();
        if (CalendarView)
        {
            _settings = await Personal.GetCalendarSettingsAsync();
            var days = MonthDays().ToList();
            _events = await Personal.GetCalendarEventsAsync(days[0], days[^1]);
        }
    }

    private Task Shift(int months)
    {
        _month = _month.AddMonths(months);
        _selected = _month.Month == _today.Month && _month.Year == _today.Year ? _today : _month;
        return RunAsync(async () =>
        {
            var days = MonthDays().ToList();
            _events = await Personal.GetCalendarEventsAsync(days[0], days[^1]);
        });
    }

    private Task SaveSettingsAsync(CalendarSettings settings) => RunAsync(async () =>
    {
        await Personal.SaveCalendarSettingsAsync(settings);
        await LoadAsync();
    });

    private void Edit(TaskItem t)
    {
        _editId = t.Id;
        _title = t.Title;
        _date = t.Date?.ToDateTime(TimeOnly.MinValue);
        _time = t.Time;
        _remind = t.Remind;
        _note = t.Note;
    }

    private void ResetForm()
    {
        _editId = null;
        _title = string.Empty;
        _date = CalendarView ? _today.ToDateTime(TimeOnly.MinValue) : null;
        _time = null;
        _remind = false;
        _note = null;
    }

    /// <summary>Новая задача или правка: у правки сохраняется отметка «выполнено».</summary>
    private Task SaveAsync() => RunAsync(async () =>
    {
        var date = CalendarView && _editId is null ? _selected : _date is { } d ? DateOnly.FromDateTime(d) : (DateOnly?)null;
        var done = _editId is not null && _items!.FirstOrDefault(t => t.Id == _editId)?.Done == true;
        _items = await Personal.SaveTaskAsync(new TaskItem(_editId ?? string.Empty, _title, date, _time, _remind, done, _note));
        ResetForm();
    });

    private Task SetDoneAsync(TaskItem t, bool done) => RunAsync(async () => _items = await Personal.SetTaskDoneAsync(t.Id, done));

    private Task DeleteAsync(TaskItem t) => RunAsync(async () => _items = await Personal.DeleteTaskAsync(t.Id));

    private async Task RunAsync(Func<Task> action)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            await action();
        }
        catch (Exception ex) when (UiErrors.IsUserFacing(ex))
        {
            _error = UiErrors.Message(ex);
        }
        finally
        {
            _busy = false;
        }
    }
}
