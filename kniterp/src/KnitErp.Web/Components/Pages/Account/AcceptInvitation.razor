@page "/account/invite"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout AccountLayout
@inject SignInService SignIn

<PageTitle>Приглашение — knitERP</PageTitle>
<HeadContent><meta name="referrer" content="no-referrer" /></HeadContent>
<h1>Установка пароля</h1>

@if (_done)
{
    <p>Пароль установлен. Теперь можно <a href="account/login">войти</a>.</p>
}
else if (_email is null)
{
    <div class="error" role="alert">Ссылка недействительна или срок приглашения истёк. Попросите администратора отправить новое.</div>
}
else
{
    <p class="muted">Учётная запись: @_email</p>
    @if (_message is not null)
    {
        <div class="error" role="alert">@_message</div>
    }

    <EditForm Model="Input" method="post" FormName="accept-invitation" OnValidSubmit="SubmitAsync">
        <label>Новый пароль <InputText @bind-Value="Input.Password" type="password" autocomplete="new-password" minlength="@SignInPolicy.PasswordMinLength" required /></label>
        <label>Повторите пароль <InputText @bind-Value="Input.Confirmation" type="password" autocomplete="new-password" required /></label>
        <p class="muted">Не короче @SignInPolicy.PasswordMinLength символов. Удобно взять фразу из нескольких слов.</p>
        <button type="submit">Сохранить пароль</button>
    </EditForm>
}

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? Token { get; set; }

    [SupplyParameterFromForm]
    private PasswordInput Input { get; set; } = default!;

    private string? _email;
    private string? _message;
    private bool _done;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        _email = await SignIn.DescribeInvitationAsync(Token, HttpContext.RequestAborted);
    }

    private async Task SubmitAsync()
    {
        try
        {
            await SignIn.AcceptInvitationAsync(Token, Input.Password, Input.Confirmation, HttpContext.RequestAborted);
            _done = true;
        }
        catch (BusinessRuleException ex)
        {
            _message = ex.Message;
            Input = new PasswordInput();
        }
    }

    private sealed class PasswordInput
    {
        public string Password { get; set; } = string.Empty;
        public string Confirmation { get; set; } = string.Empty;
    }
}
