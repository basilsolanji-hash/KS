@page "/account/forgot-password"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout AccountLayout
@inject PasswordResetService PasswordReset

<PageTitle>@L("Забыли пароль") — knitERP</PageTitle>
<h1>@L("Забыли пароль")</h1>

@*
    D81: ответ одинаковый для любого адреса — по нему нельзя узнать, есть ли такой пользователь.
    Без настроенной почты — подсказка, к кому обратиться.
*@
@if (!PasswordReset.SelfServiceAvailable)
{
    <p>@L("Восстановление пароля по почте на этом сервере не настроено.")</p>
    <p class="muted">@L("Попросите администратора вашей организации выдать ссылку смены пароля: «Настройки» → «Пользователи» → «Сменить пароль». Если вы единственный Владелец и потеряли доступ — администратору сервера поможет аварийная команда (см. инструкцию по эксплуатации).")</p>
}
else if (_sent)
{
    <div class="flash" role="status">@L("Если такой адрес зарегистрирован, на него отправлено письмо со ссылкой. Ссылка действует 1 час.")</div>
    <p class="muted">@L("Письма нет несколько минут — проверьте папку «Спам». Повторно запросить ссылку можно через 5 минут.")</p>
}
else
{
    <p class="muted">@L("Укажите почту, с которой входите. Мы пришлём ссылку для нового пароля. Код из приложения-аутентификатора при входе по-прежнему понадобится.")</p>
    @if (_message is not null)
    {
        <div class="error" role="alert">@_message</div>
    }

    <EditForm Model="Input" method="post" FormName="forgot-password" OnValidSubmit="SubmitAsync">
        <label>@L("Эл. почта") <InputText @bind-Value="Input.Email" type="email" autocomplete="username" maxlength="254" required /></label>
        <button type="submit">@L("Получить ссылку")</button>
    </EditForm>
}

<p style="margin-top: 24px"><a href="account/login">@L("Вернуться ко входу")</a></p>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private EmailInput Input { get; set; } = default!;

    private bool _sent;
    private string? _message;

    protected override void OnInitialized() => Input ??= new();

    private async Task SubmitAsync()
    {
        try
        {
            await PasswordReset.RequestAsync(Input.Email, HttpContext.RequestAborted);
            _sent = true;
        }
        catch (BusinessRuleException ex)
        {
            _message = KnitErp.Web.Components.Shared.UiErrors.Message(ex);
        }
    }

    private sealed class EmailInput
    {
        public string Email { get; set; } = string.Empty;
    }
}
