@page "/account/reset-password"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout AccountLayout
@inject PasswordResetService PasswordReset

<PageTitle>@L("Новый пароль") — knitERP</PageTitle>
<HeadContent><meta name="referrer" content="no-referrer" /></HeadContent>
<h1>@L("Новый пароль")</h1>

@if (_done)
{
    <div class="flash" role="status">@L("Пароль изменён. Все открытые сессии закрыты, доверенные устройства сброшены.")</div>
    <p><a href="account/login">@L("Войти")</a></p>
}
else if (_email is null)
{
    <div class="error" role="alert">@L("Ссылка недействительна или её срок истёк.")</div>
    <p><a href="account/forgot-password">@L("Запросить новую ссылку")</a></p>
}
else
{
    <p class="muted">@L("Учётная запись"): @_email</p>
    @if (_message is not null)
    {
        <div class="error" role="alert">@_message</div>
    }

    <EditForm Model="Input" method="post" FormName="reset-password" OnValidSubmit="SubmitAsync">
        <label>@L("Новый пароль") <InputText @bind-Value="Input.Password" type="password" autocomplete="new-password" minlength="@SignInPolicy.PasswordMinLength" required /></label>
        <label>@L("Повторите пароль") <InputText @bind-Value="Input.Confirmation" type="password" autocomplete="new-password" required /></label>
        <p class="muted">@L("Не короче {0} символов. Удобно взять фразу из нескольких слов.", SignInPolicy.PasswordMinLength)</p>
        <button type="submit">@L("Сохранить пароль")</button>
    </EditForm>
}

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? Token { get; set; }

    [SupplyParameterFromForm]
    private PasswordInput Input { get; set; } = default!;

    private string? _email;
    private string? _message;
    private bool _done;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        _email = await PasswordReset.DescribeAsync(Token, HttpContext.RequestAborted);
    }

    private async Task SubmitAsync()
    {
        try
        {
            await PasswordReset.ResetAsync(Token, Input.Password, Input.Confirmation, HttpContext.RequestAborted);
            _done = true;
        }
        catch (BusinessRuleException ex)
        {
            _message = KnitErp.Web.Components.Shared.UiErrors.Message(ex);
            Input = new PasswordInput();
        }
    }

    private sealed class PasswordInput
    {
        public string Password { get; set; } = string.Empty;
        public string Confirmation { get; set; } = string.Empty;
    }
}
