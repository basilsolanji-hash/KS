@page "/employees"
@using KnitErp.Application.Structure
@using KnitErp.Domain.Structure
@using KnitErp.Web.Components.Shared
@inject EmployeeService Employees

<PageTitle>Сотрудники — knitERP</PageTitle>

@if (_denied is not null)
{
    <AccessDenied Message="@_denied" />
}
else if (_list is null)
{
    <p class="muted">Загрузка…</p>
}
else
{
    <div class="page-head">
        <h1>@(_list.OwnOnly ? "Моя карточка" : "Сотрудники")</h1>
        @if (_list.CanEdit && _mode == Mode.None)
        {
            <button type="button" @onclick="OpenHireAsync" disabled="@_busy">Принять сотрудника</button>
        }
    </div>

    @if (_list.IsScoped)
    {
        <p class="muted">Вы видите сотрудников своего подразделения и вложенных в него.</p>
    }

    @if (_flash is not null)
    {
        <div class="@(_flashIsError ? "flash error" : "flash")" role="@(_flashIsError ? "alert" : "status")"><span>@_flash</span><button type="button" class="link" aria-label="Закрыть сообщение" @onclick="() => _flash = null">×</button></div>
    }

    @if (_mode is Mode.Hire or Mode.Edit)
    {
        <div class="panel">
            <h2>@(_mode == Mode.Hire ? "Приём сотрудника" : $"Карточка: {_target!.FullName}")</h2>
            @if (_options is { Departments.Count: 0 } or { Positions.Count: 0 })
            {
                <p class="muted">Сначала заведите подразделения и должности в разделе «Структура».</p>
            }
            <EditForm Model="_form" OnValidSubmit="SaveAsync" FormName="employee">
                <div class="grid">
                    <label>Табельный номер <InputText @bind-Value="_form.PersonnelNumber" maxlength="20" required /></label>
                    <label>Дата приёма <InputDate @bind-Value="_form.HiredOn" disabled="@(_mode == Mode.Edit)" /></label>
                    <label>Фамилия <InputText @bind-Value="_form.LastName" maxlength="100" required /></label>
                    <label>Имя <InputText @bind-Value="_form.FirstName" maxlength="100" required /></label>
                    <label>Отчество <InputText @bind-Value="_form.MiddleName" maxlength="100" /></label>
                    <label>
                        Подразделение
                        <InputSelect @bind-Value="_form.DepartmentId" required>
                            <option value="0">— выберите —</option>
                            @foreach (var d in _options?.Departments ?? [])
                            {
                                <option value="@d.Id">@d.Name</option>
                            }
                        </InputSelect>
                    </label>
                    <label>
                        Должность
                        <InputSelect @bind-Value="_form.PositionId" required>
                            <option value="0">— выберите —</option>
                            @foreach (var p in _options?.Positions ?? [])
                            {
                                <option value="@p.Id">@p.Name</option>
                            }
                        </InputSelect>
                    </label>
                </div>
                @if (_formError is not null)
                {
                    <div class="error" role="alert">@_formError</div>
                }
                <div class="actions">
                    <button type="submit" disabled="@_busy">@(_mode == Mode.Hire ? "Принять" : "Сохранить")</button>
                    <button type="button" class="secondary" @onclick="Close" disabled="@_busy">Отмена</button>
                </div>
            </EditForm>
        </div>
    }

    @if (_mode == Mode.Dismiss)
    {
        <div class="panel">
            <h2>Увольнение: @_target!.FullName</h2>
            <p class="muted">
                Карточка закрывается для изменений, история сохраняется.
                @if (_target.UserId is not null)
                {
                    <text>У сотрудника есть учётная запись — доступ к организации будет заблокирован в той же операции.</text>
                }
            </p>
            <EditForm Model="_form" OnValidSubmit="DismissAsync" FormName="dismiss">
                <div class="grid">
                    <label>Дата увольнения <InputDate @bind-Value="_form.DismissedOn" required /></label>
                    <label>Причина (обязательна) <InputText @bind-Value="_form.Reason" maxlength="500" required /></label>
                </div>
                @if (_formError is not null)
                {
                    <div class="error" role="alert">@_formError</div>
                }
                <div class="actions">
                    <button type="submit" disabled="@_busy">Уволить</button>
                    <button type="button" class="secondary" @onclick="Close" disabled="@_busy">Отмена</button>
                </div>
            </EditForm>
        </div>
    }

    @if (!_list.OwnOnly)
    {
        <form class="inline-form" @onsubmit="ReloadAsync">
            <label>Поиск <input @bind="_search" placeholder="Фамилия, имя или табельный номер" /></label>
            <label class="inline"><input type="checkbox" @bind="_includeDismissed" /> Показать уволенных</label>
            <button type="submit" class="secondary" disabled="@_busy">Найти</button>
        </form>
    }

    <div class="scroll">
        <table>
            <thead>
                <tr>
                    <th class="opt">Таб. №</th><th>Сотрудник</th><th>Подразделение</th><th class="opt">Должность</th><th>Статус</th><th class="opt">Учётная запись</th>
                    @if (_list.CanEdit)
                    {
                        <th>Действия</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (_list.Employees.Count == 0)
                {
                    <tr><td colspan="7" class="muted">@(_list.OwnOnly ? "Карточка сотрудника не привязана к вашей учётной записи." : "Сотрудников не найдено.")</td></tr>
                }
                @foreach (var e in _list.Employees)
                {
                    <tr class="@(e.Status == EmploymentStatus.Dismissed ? "archived" : null)">
                        <td>@e.PersonnelNumber</td>
                        <td>@e.FullName<div class="muted">с @e.HiredOn.ToString("dd.MM.yyyy")</div></td>
                        <td>@e.DepartmentName</td>
                        <td>@e.PositionName</td>
                        <td>
                            <span class="tag @StatusClass(e.Status)">@e.StatusName</span>
                            @if (e.DismissedOn is { } d)
                            {
                                <div class="muted">@d.ToString("dd.MM.yyyy")</div>
                            }
                        </td>
                        <td>@(e.UserEmail ?? "—")</td>
                        @if (_list.CanEdit)
                        {
                            <td>
                                @if (e.Status != EmploymentStatus.Dismissed)
                                {
                                    <div class="row-actions">
                                        <button type="button" class="secondary" @onclick="() => OpenEditAsync(e)" disabled="@(_busy || _mode != Mode.None)">Изменить</button>
                                        <button type="button" class="secondary" @onclick="() => ToggleLeaveAsync(e)" disabled="@(_busy || _mode != Mode.None)">
                                            @(e.Status == EmploymentStatus.OnLeave ? "Вернуть из отпуска" : "В отпуск")
                                        </button>
                                        <button type="button" class="secondary" @onclick="() => OpenDismiss(e)" disabled="@(_busy || _mode != Mode.None)">Уволить</button>
                                    </div>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private enum Mode { None, Hire, Edit, Dismiss }

    [CascadingParameter]
    public CurrentAccessDto CurrentAccess { get; set; } = default!;

    private EmployeeListDto? _list;
    private EmployeeOptionsDto? _options;
    private EmployeeForm _form = new();
    private EmployeeRowDto? _target;
    private Mode _mode;
    private bool _busy;
    private string? _denied;
    private string? _formError;
    private string? _flash;
    private bool _flashIsError;
    private string _search = string.Empty;
    private bool _includeDismissed;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _list = await Employees.ListAsync(new EmployeeFilter());
        }
        catch (AccessDeniedException ex)
        {
            _denied = ex.Message;
        }
    }

    private Task ReloadAsync() => RunAsync(() => Task.CompletedTask);

    private Task OpenHireAsync() => RunAsync(async () =>
    {
        _options = await Employees.GetOptionsAsync();
        _form = new EmployeeForm { HiredOn = Today() };
        _target = null;
        _mode = Mode.Hire;
    });

    private Task OpenEditAsync(EmployeeRowDto e) => RunAsync(async () =>
    {
        _options = await Employees.GetOptionsAsync();
        _form = new EmployeeForm
        {
            PersonnelNumber = e.PersonnelNumber, LastName = e.LastName, FirstName = e.FirstName, MiddleName = e.MiddleName,
            DepartmentId = e.DepartmentId, PositionId = e.PositionId, HiredOn = e.HiredOn,
        };
        _target = e;
        _mode = Mode.Edit;
    });

    private void OpenDismiss(EmployeeRowDto e)
    {
        _flash = null;
        _flashIsError = false;
        _formError = null;
        _form = new EmployeeForm { DismissedOn = Today() };
        _target = e;
        _mode = Mode.Dismiss;
    }

    private void Close()
    {
        _mode = Mode.None;
        _target = null;
        _formError = null;
    }

    private Task SaveAsync() => RunAsync(async () =>
    {
        var cmd = new EmployeeCommand(_form.PersonnelNumber, _form.LastName, _form.FirstName, _form.MiddleName,
            _form.DepartmentId, _form.PositionId, _form.HiredOn);
        if (_mode == Mode.Hire)
        {
            await Employees.HireAsync(cmd);
            _flash = $"Сотрудник «{_form.LastName} {_form.FirstName}» принят.";
        }
        else
        {
            await Employees.UpdateAsync(_target!.Id, cmd, _target.RowVersion);
            _flash = "Карточка сохранена.";
        }

        Close();
    });

    private Task ToggleLeaveAsync(EmployeeRowDto e) => RunAsync(async () =>
    {
        await Employees.SetOnLeaveAsync(e.Id, e.Status != EmploymentStatus.OnLeave, e.RowVersion);
        _flash = e.Status == EmploymentStatus.OnLeave ? $"Сотрудник «{e.FullName}» снова работает." : $"Сотрудник «{e.FullName}» в отпуске.";
    });

    private Task DismissAsync() => RunAsync(async () =>
    {
        var target = _target!;
        await Employees.DismissAsync(target.Id, _form.DismissedOn, _form.Reason, target.RowVersion);
        _flash = target.UserId is null
            ? $"Сотрудник «{target.FullName}» уволен."
            : $"Сотрудник «{target.FullName}» уволен, доступ к организации заблокирован.";
        Close();
    });

    /// <summary>Одна операция за раз, затем свежий список: у вкладки один DbContext.</summary>
    private async Task RunAsync(Func<Task> action)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _formError = null;
        _flashIsError = false;
        try
        {
            await action();
        }
        catch (Exception ex) when (UiErrors.IsUserFacing(ex))
        {
            if (_mode == Mode.None)
            {
                _flash = UiErrors.Message(ex);
                _flashIsError = true;
            }
            else
            {
                _formError = UiErrors.Message(ex);
            }
        }
        finally
        {
            try
            {
                _list = await Employees.ListAsync(new EmployeeFilter(null, _includeDismissed, _search));
            }
            finally
            {
                _busy = false;
            }
        }
    }

    private DateOnly Today() => DateOnly.FromDateTime(TimeZones.ToLocal(DateTime.UtcNow, CurrentAccess.TimeZoneId));

    private static string StatusClass(EmploymentStatus status) => status switch
    {
        EmploymentStatus.Working => "ok",
        EmploymentStatus.OnLeave => "warn",
        _ => "bad",
    };

    private sealed class EmployeeForm
    {
        public string PersonnelNumber { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string FirstName { get; set; } = string.Empty;
        public string? MiddleName { get; set; }
        public long DepartmentId { get; set; }
        public long PositionId { get; set; }
        public DateOnly HiredOn { get; set; }
        public DateOnly DismissedOn { get; set; }
        public string? Reason { get; set; }
    }
}
