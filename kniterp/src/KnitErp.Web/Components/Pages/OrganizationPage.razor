@page "/organization"
@using KnitErp.Web.Components.Shared
@inject OrganizationService Organizations

<PageTitle>@L("Организация") — knitERP</PageTitle>

@if (_denied is not null)
{
    <AccessDenied Message="@_denied" />
}
else if (_org is null)
{
    <p class="muted">@L("Загрузка…")</p>
}
else
{
    <div class="page-head">
        <h1>@L("Организация")</h1>
        @if (_org.CanEdit && !_editing)
        {
            <button type="button" @onclick="StartEdit">@L("Изменить")</button>
        }
    </div>

    @if (_message is not null)
    {
        <div class="error" role="alert">@_message</div>
    }

    <EditForm Model="_draft" OnValidSubmit="SaveAsync" FormName="organization">
        <table>
            <tr><td class="muted">@L("Полное наименование")</td><td>@_org.FullName</td></tr>
            <tr><td class="muted">@L("Страна")</td><td>@_org.Country.Name</td></tr>
            <tr><td class="muted">@_org.Country.TaxIdName</td><td>@_org.Inn</td></tr>
            @if (_org.Country.HasKpp)
            {
            <tr>
                <td class="muted">@L("КПП")</td>
                <td>@(_org.Kpp ?? "—") @if (_org.Kpp is not null && !_org.KppVerified) { <span class="tag">@L("требует сверки · D15")</span><div class="muted">@L("До сверки по документу организации КПП не выводится в печатные формы.")</div> }</td>
            </tr>
            }
            <tr>
                <td class="muted"><label for="org-address">@L("Фактический адрес")</label></td>
                <td>
                    @if (_editing)
                    {
                        <InputText id="org-address" @bind-Value="_draft.Address" maxlength="500" style="width: 100%" />
                    }
                    else
                    {
                        @(_org.ActualAddress ?? "—")
                    }
                </td>
            </tr>
            <tr>
                <td class="muted"><label for="org-site">@L("Сайт фабрики")</label></td>
                <td>
                    @if (_editing)
                    {
                        <InputText id="org-site" @bind-Value="_draft.Website" maxlength="300" style="width: 100%" placeholder="https://fabrika.ru" />
                        <div class="muted">@L("Открывается ярлыком «Сайт фабрики» на панели быстрого доступа.")</div>
                    }
                    else if (_org.WebsiteUrl is { } site)
                    {
                        <a href="@site" target="_blank" rel="noopener noreferrer">@site</a>
                    }
                    else
                    {
                        @("—")
                    }
                </td>
            </tr>
            <tr>
                <td class="muted"><label for="org-tz">@L("Часовой пояс учёта")</label></td>
                <td>
                    @if (_editing)
                    {
                        <InputSelect id="org-tz" @bind-Value="_draft.TimeZoneId">
                            @foreach (var zone in TimeZones.Russian)
                            {
                                <option value="@zone.Id">@zone.Label</option>
                            }
                        </InputSelect>
                    }
                    else
                    {
                        @TimeZones.Label(_org.TimeZoneId)
                    }
                </td>
            </tr>
            <tr><td class="muted">@L("Валюта учёта")</td><td>@_org.CurrencyCode — @_org.Country.CurrencyName</td></tr>
        </table>

        @if (_editing)
        {
            <div class="actions">
                <button type="submit" disabled="@_busy">@L("Сохранить")</button>
                <button type="button" class="secondary" @onclick="CancelEdit" disabled="@_busy">@L("Отмена")</button>
            </div>
        }
    </EditForm>

    <div class="page-head" style="margin-top: 20px">
        <h2>@L("Реквизиты для печати")</h2>
        @if (_org.CanEdit && _print is null)
        {
            <button type="button" class="secondary" @onclick="StartPrintEdit">@L("Изменить")</button>
        }
    </div>
    <p class="muted">@L("Печатаются в счёте на оплату и УПД. Для России БИК и счета проверяются по контрольному ключу.")</p>
    @if (_printError is not null)
    {
        <div class="error" role="alert">@_printError</div>
    }
    var pr = _org.PrintRequisites;
    <form @onsubmit="SavePrintAsync">
        <table>
            @PrintRow(L("Юридический адрес"), pr.LegalAddress, 500, v => _print!.LegalAddress = v, () => _print?.LegalAddress)
            @PrintRow(L("Банк"), pr.BankName, 300, v => _print!.BankName = v, () => _print?.BankName)
            @PrintRow(L("БИК"), pr.BankBic, 11, v => _print!.BankBic = v, () => _print?.BankBic)
            @PrintRow(L("Расчётный счёт"), pr.BankAccount, 40, v => _print!.BankAccount = v, () => _print?.BankAccount)
            @PrintRow(L("Корреспондентский счёт"), pr.BankCorrAccount, 40, v => _print!.BankCorrAccount = v, () => _print?.BankCorrAccount)
            @PrintRow(L("Руководитель"), pr.DirectorName, 150, v => _print!.DirectorName = v, () => _print?.DirectorName)
            @PrintRow(L("Главный бухгалтер"), pr.AccountantName, 150, v => _print!.AccountantName = v, () => _print?.AccountantName)
        </table>
        @if (_print is not null)
        {
            <div class="actions">
                <button type="submit" disabled="@_busy">@L("Сохранить")</button>
                <button type="button" class="secondary" @onclick="() => { _print = null; _printError = null; }" disabled="@_busy">@L("Отмена")</button>
            </div>
        }
    </form>

    @if (!_org.CanEdit)
    {
        <p class="muted">@L("У вашей роли только просмотр реквизитов.")</p>
    }
}

@code {
    private OrganizationDto? _org;
    private RequisitesDraft _draft = new();
    private bool _editing;
    private bool _busy;
    private string? _denied;
    private string? _message;
    private PrintDraft? _print;
    private string? _printError;

    /// <summary>Строка реквизита: в просмотре — значение, в правке — поле ввода.</summary>
    private RenderFragment PrintRow(string label, string? value, int max, Action<string?> set, Func<string?> get) => __builder =>
    {
        <tr>
            <td class="muted" style="width: 220px">@label</td>
            <td>
                @if (_print is not null)
                {
                    <input value="@get()" @onchange="e => set(e.Value?.ToString())" maxlength="@max" style="width: 100%" aria-label="@label" />
                }
                else
                {
                    @(value ?? "—")
                }
            </td>
        </tr>
    };

    private void StartPrintEdit()
    {
        var p = _org!.PrintRequisites;
        _print = new PrintDraft
        {
            LegalAddress = p.LegalAddress, BankName = p.BankName, BankBic = p.BankBic, BankAccount = p.BankAccount,
            BankCorrAccount = p.BankCorrAccount, DirectorName = p.DirectorName, AccountantName = p.AccountantName,
        };
        _printError = null;
    }

    private async Task SavePrintAsync()
    {
        if (_print is null || _busy)
        {
            return;
        }

        _busy = true;
        try
        {
            _org = await Organizations.UpdatePrintRequisitesAsync(new UpdatePrintRequisitesCommand(new KnitErp.Domain.Organizations.PrintRequisites(
                _print.LegalAddress, _print.BankName, _print.BankBic, _print.BankAccount, _print.BankCorrAccount, _print.DirectorName, _print.AccountantName),
                _org!.RowVersion));
            _print = null;
            _printError = null;
        }
        catch (Exception ex) when (UiErrors.IsUserFacing(ex))
        {
            _printError = UiErrors.Message(ex);
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class PrintDraft
    {
        public string? LegalAddress { get; set; }
        public string? BankName { get; set; }
        public string? BankBic { get; set; }
        public string? BankAccount { get; set; }
        public string? BankCorrAccount { get; set; }
        public string? DirectorName { get; set; }
        public string? AccountantName { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _org = await Organizations.GetCurrentAsync();
        }
        catch (AccessDeniedException ex)
        {
            _denied = UiErrors.Message(ex);
        }
    }

    private void StartEdit()
    {
        _draft = new RequisitesDraft { Address = _org!.ActualAddress ?? string.Empty, TimeZoneId = _org.TimeZoneId, Website = _org.WebsiteUrl ?? string.Empty };
        _message = null;
        _editing = true;
    }

    private void CancelEdit()
    {
        _editing = false;
        _message = null;
    }

    private async Task SaveAsync()
    {
        _busy = true;
        try
        {
            _org = await Organizations.UpdateRequisitesAsync(new UpdateRequisitesCommand(_draft.Address, _draft.TimeZoneId, _org!.RowVersion, _draft.Website));
            _editing = false;
            _message = null;
        }
        catch (Exception ex) when (UiErrors.IsUserFacing(ex))
        {
            _message = UiErrors.Message(ex);
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class RequisitesDraft
    {
        public string Website { get; set; } = string.Empty;

        public string Address { get; set; } = string.Empty;
        public string TimeZoneId { get; set; } = "Europe/Moscow";
    }
}
