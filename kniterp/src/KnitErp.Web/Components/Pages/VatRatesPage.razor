@page "/vat-rates"
@using KnitErp.Application.Catalog
@using KnitErp.Domain.Catalog
@using KnitErp.Web.Components.Shared
@inject VatRateService VatRates

<PageTitle>Ставки НДС — knitERP</PageTitle>

@if (_denied is not null)
{
    <AccessDenied Message="@_denied" />
}
else if (_list is null)
{
    <p class="muted">Загрузка…</p>
}
else
{
    <div class="page-head">
        <h1>Ставки НДС</h1>
        @if (_list.CanEdit && !_creating)
        {
            <button type="button" @onclick="() => { _creating = true; _flash = null; }" disabled="@_busy">Добавить ставку</button>
        }
    </div>
    <p class="muted">
        Ставки страны организации (@_list.CountryName). Номенклатура ссылается на вид ставки, а процент берётся по дате:
        когда закон меняет ставку, добавьте новый процент с даты — менять номенклатуру не нужно.
        Льготные перечни товаров у каждой страны свои — сверьте с бухгалтером.
    </p>

    @if (_flash is not null)
    {
        <div class="@(_flashIsError ? "flash error" : "flash")" role="@(_flashIsError ? "alert" : "status")"><span>@_flash</span></div>
    }

    @if (_creating)
    {
        <div class="panel">
            <h2>Новая ставка</h2>
            <div class="grid">
                <label>Наименование <input @bind="_name" maxlength="100" placeholder="Например: Пониженная 10%" /></label>
                <label>
                    Вид
                    <select @bind="_kind">
                        @foreach (var k in Enum.GetValues<VatRateKind>())
                        {
                            <option value="@k">@VatRate.KindName(k)</option>
                        }
                    </select>
                </label>
                @if (_kind != VatRateKind.Exempt)
                {
                    <label>Процент <input type="number" step="0.01" min="0" max="100" @bind="_percent" /></label>
                    <label>Действует с <input type="date" @bind="_from" /></label>
                }
            </div>
            <div class="actions" style="margin-top: 12px">
                <button type="button" @onclick="CreateAsync" disabled="@_busy">Сохранить</button>
                <button type="button" class="secondary" @onclick="() => _creating = false" disabled="@_busy">Отмена</button>
            </div>
        </div>
    }

    @if (_period is not null)
    {
        <div class="panel">
            <h2>Новый процент: @_period.Name</h2>
            <div class="grid">
                <label>Процент <input type="number" step="0.01" min="0" max="100" @bind="_percent" /></label>
                <label>Действует с <input type="date" @bind="_from" /></label>
            </div>
            <div class="actions" style="margin-top: 12px">
                <button type="button" @onclick="AddPeriodAsync" disabled="@_busy">Добавить</button>
                <button type="button" class="secondary" @onclick="() => _period = null" disabled="@_busy">Отмена</button>
            </div>
        </div>
    }

    <label class="inline" style="margin: 8px 0"><input type="checkbox" @bind="_includeArchived" @bind:after="ReloadAsync" /> Показать архив</label>

    <div class="scroll">
        <table>
            <thead><tr><th>Ставка</th><th>Сейчас</th><th class="opt">История</th><th class="opt num">Позиций</th>@if (_list.CanEdit) { <th>Действия</th> }</tr></thead>
            <tbody>
                @foreach (var r in _list.Rates)
                {
                    <tr class="@(r.IsArchived ? "archived" : null)">
                        <td>@r.Name <span class="tag">@r.KindName</span>@if (r.IsArchived) { <span class="tag">архив</span> }</td>
                        <td><b>@r.CurrentText</b></td>
                        <td>
                            @foreach (var p in r.Periods)
                            {
                                <div>@p.Percent.ToString("0.##")% с @p.ValidFrom.ToString("dd.MM.yyyy")@(p.ValidTo is { } to ? $" по {to:dd.MM.yyyy}" : "")</div>
                            }
                        </td>
                        <td class="num">@r.ItemCount</td>
                        @if (_list.CanEdit)
                        {
                            <td>
                                <div class="row-actions">
                                    @if (!r.IsArchived && r.Kind != VatRateKind.Exempt && r.Kind != VatRateKind.Zero)
                                    {
                                        <button type="button" class="secondary" @onclick="() => OpenPeriod(r)" disabled="@_busy">Новый процент</button>
                                    }
                                    @if (r.IsArchived)
                                    {
                                        <button type="button" class="secondary" @onclick="() => RestoreAsync(r)" disabled="@_busy">Вернуть</button>
                                    }
                                    else
                                    {
                                        <button type="button" class="secondary" @onclick="() => ArchiveAsync(r)" disabled="@_busy">В архив</button>
                                    }
                                </div>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private VatRateListDto? _list;
    private bool _busy;
    private bool _creating;
    private bool _includeArchived;
    private string? _denied;
    private string? _flash;
    private bool _flashIsError;
    private string _name = string.Empty;
    private VatRateKind _kind = VatRateKind.Reduced;
    private decimal _percent;
    private DateTime _from = new(DateTime.Today.Year, 1, 1);
    private VatRateDto? _period;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _list = await VatRates.ListAsync();
        }
        catch (AccessDeniedException ex)
        {
            _denied = UiErrors.Message(ex);
        }
    }

    private void OpenPeriod(VatRateDto r)
    {
        _period = r;
        _percent = r.CurrentPercent ?? 0;
        _from = new DateTime(DateTime.Today.Year + 1, 1, 1);
        _flash = null;
    }

    private Task CreateAsync() => RunAsync(async () =>
    {
        await VatRates.CreateAsync(_name, _kind, _kind == VatRateKind.Exempt ? null : DateOnly.FromDateTime(_from),
            _kind == VatRateKind.Exempt ? null : _percent);
        _creating = false;
        _name = string.Empty;
    }, "Ставка добавлена.");

    private Task AddPeriodAsync() => RunAsync(async () =>
    {
        await VatRates.AddPeriodAsync(_period!.Id, DateOnly.FromDateTime(_from), _percent, _period.RowVersion);
        _period = null;
    }, "Процент добавлен.");

    private Task ArchiveAsync(VatRateDto r) => RunAsync(() => VatRates.ArchiveAsync(r.Id, r.RowVersion), $"Ставка «{r.Name}» в архиве.");

    private Task RestoreAsync(VatRateDto r) => RunAsync(() => VatRates.RestoreAsync(r.Id, r.RowVersion), $"Ставка «{r.Name}» возвращена.");

    private Task ReloadAsync() => RunAsync(() => Task.CompletedTask, null);

    private async Task RunAsync(Func<Task> action, string? success)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _flash = null;
        try
        {
            await action();
            _flash = success;
            _flashIsError = false;
        }
        catch (Exception ex) when (UiErrors.IsUserFacing(ex))
        {
            _flash = UiErrors.Message(ex);
            _flashIsError = true;
        }
        finally
        {
            try
            {
                _list = await VatRates.ListAsync(_includeArchived);
            }
            catch (Exception ex) when (UiErrors.IsUserFacing(ex))
            {
                _flash ??= UiErrors.Message(ex);
            }

            _busy = false;
        }
    }
}
