@page "/opening-balances/{Id:long}"
@using KnitErp.Application.Warehousing
@using KnitErp.Domain.Warehousing
@using KnitErp.Web.Components.Shared
@inject OpeningBalanceService Balances

<PageTitle>@(_doc?.Number ?? "Документ") — knitERP</PageTitle>

@if (_denied is not null)
{
    <AccessDenied Message="@_denied" />
}
else if (_notFound)
{
    <h1>Документ не найден</h1>
    <p><a href="opening-balances">К списку документов</a></p>
}
else if (_doc is null)
{
    <p class="muted">Загрузка…</p>
}
else
{
    <p><a href="opening-balances">← Начальные остатки</a></p>
    <div class="page-head">
        <h1>@_doc.Number <span class="tag @OpeningBalancesPage.StatusClass(_doc.Status)">@_doc.StatusName</span></h1>
    </div>
    <table style="max-width: 720px">
        <tr><td class="muted">Склад</td><td>@_doc.WarehouseName</td></tr>
        <tr><td class="muted">Остатки на дату</td><td>@_doc.AsOfDate.ToString("dd.MM.yyyy")</td></tr>
        <tr><td class="muted">Автор</td><td>@_doc.CreatedBy, @Local(_doc.CreatedAtUtc)</td></tr>
        @if (_doc.ApprovedBy is not null)
        {
            <tr><td class="muted">Утвердил</td><td>@_doc.ApprovedBy, @Local(_doc.ApprovedAtUtc!.Value)</td></tr>
        }
        @if (_doc.Comment is not null)
        {
            <tr><td class="muted">Комментарий</td><td>@_doc.Comment</td></tr>
        }
    </table>

    @if (_doc.Status == OpeningBalanceStatus.Draft && _doc.ReturnReason is not null)
    {
        <div class="error" role="alert" style="margin-top: 16px">Возвращён на доработку: @_doc.ReturnReason</div>
    }

    @if (_message is not null)
    {
        <div class="@(_messageIsError ? "flash error" : "flash")" role="@(_messageIsError ? "alert" : "status")">@_message</div>
    }

    <h2 style="margin-top: 24px">Строки (@_doc.Lines.Count)</h2>

    @if (_doc.CanEdit)
    {
        <form class="inline-form" @onsubmit="AddLineAsync">
            <label>
                Позиция
                <input list="items" @bind="_itemText" size="40" placeholder="Начните вводить код или наименование" />
                <datalist id="items">
                    @foreach (var i in _items)
                    {
                        <option value="@($"{i.Code} — {i.Name}")">@i.UnitSymbol</option>
                    }
                </datalist>
            </label>
            <label>Количество <input @bind="_qtyText" inputmode="decimal" size="10" /></label>
            <button type="submit" disabled="@_busy">Добавить</button>
        </form>
        <div class="actions">
            <a class="button secondary" href="opening-balances/template.xlsx" download data-enhance-nav="false">Шаблон Excel</a>
            <label class="inline">Загрузить строки из Excel (заменят текущие) <InputFile OnChange="ImportAsync" accept=".xlsx" disabled="@_busy" /></label>
        </div>
    }

    @if (_import is { Applied: false })
    {
        <div class="error" role="alert">В файле есть ошибки (@_import.ErrorRows) — строки не загружены.</div>
        <div class="scroll" style="max-height: 300px; overflow-y: auto">
            <table>
                <thead><tr><th>Строка</th><th>Код</th><th>Количество</th><th>Ошибки</th></tr></thead>
                <tbody>
                    @foreach (var r in _import.Rows.Where(r => r.Errors.Count > 0).Take(500))
                    {
                        <tr><td>@r.RowNumber</td><td>@r.Code</td><td>@r.QuantityText</td><td>@string.Join(" ", r.Errors)</td></tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <div class="scroll">
        <table>
            <thead><tr><th>Код</th><th>Наименование</th><th style="text-align: right">Количество</th><th>Ед.</th>@if (_doc.CanEdit) { <th></th> }</tr></thead>
            <tbody>
                @if (_doc.Lines.Count == 0)
                {
                    <tr><td colspan="5" class="muted">Строк пока нет.</td></tr>
                }
                @foreach (var l in _doc.Lines)
                {
                    <tr>
                        <td>@l.Code</td>
                        <td>@l.Name</td>
                        <td style="text-align: right">@Quantities.Format(l.Quantity)</td>
                        <td>@l.UnitSymbol</td>
                        @if (_doc.CanEdit)
                        {
                            <td><button type="button" class="secondary" @onclick="() => RemoveLineAsync(l)" disabled="@_busy" aria-label="Удалить строку @l.Code">Удалить</button></td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="actions" style="margin-top: 16px">
        @if (_doc.CanEdit)
        {
            <button type="button" @onclick="SubmitAsync" disabled="@(_busy || _doc.Lines.Count == 0)">Отправить на утверждение</button>
            <button type="button" class="secondary" @onclick="CancelAsync" disabled="@_busy">Отменить документ</button>
        }
        @if (_doc.CanApprove)
        {
            <button type="button" @onclick="ApproveAsync" disabled="@_busy">Утвердить</button>
        }
    </div>

    @if (_doc.CanApprove)
    {
        <form class="inline-form" @onsubmit="ReturnAsync">
            <label>Причина возврата <input @bind="_returnReason" maxlength="500" size="40" /></label>
            <button type="submit" class="secondary" disabled="@_busy">Вернуть на доработку</button>
        </form>
    }

    @if (_doc.Status == OpeningBalanceStatus.Submitted && !_doc.CanApprove && CurrentAccess.Has(Permissions.OpeningBalanceApprove))
    {
        <p class="muted">Вы автор этого документа — утвердить его должен другой человек.</p>
    }
}

@code {
    [Parameter]
    public long Id { get; set; }

    [CascadingParameter]
    public CurrentAccessDto CurrentAccess { get; set; } = default!;

    private OpeningBalanceDto? _doc;
    private IReadOnlyList<EntryItemDto> _items = [];
    private LineImportResult? _import;
    private bool _busy;
    private bool _notFound;
    private string? _denied;
    private string? _message;
    private bool _messageIsError;
    private string _itemText = string.Empty;
    private string _qtyText = string.Empty;
    private string _returnReason = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadAsync();
            if (_doc!.CanEdit)
            {
                _items = await Balances.ListItemsForEntryAsync();
            }
        }
        catch (AccessDeniedException ex)
        {
            _denied = ex.Message;
        }
        catch (NotFoundException)
        {
            _notFound = true;
        }
    }

    private async Task LoadAsync() => _doc = await Balances.GetAsync(Id);

    private Task AddLineAsync() => RunAsync(async () =>
    {
        var code = _itemText.Split(" — ", 2)[0].Trim();
        var item = _items.FirstOrDefault(i => string.Equals(i.Code, code, StringComparison.OrdinalIgnoreCase))
                   ?? throw new BusinessRuleException("stock.item.unknown", $"Позиция «{_itemText}» не найдена. Выберите из списка.");
        if (!Quantities.TryParse(_qtyText, out var qty))
        {
            throw new BusinessRuleException("stock.quantity.invalid", "Укажите количество числом, например 12,5.");
        }

        await Balances.SetLineAsync(Id, item.Id, qty, _doc!.RowVersion);
        _itemText = string.Empty;
        _qtyText = string.Empty;
    }, null);

    private Task RemoveLineAsync(OpeningBalanceLineDto line) => RunAsync(() => Balances.RemoveLineAsync(Id, line.ItemId, _doc!.RowVersion), null);

    private Task ImportAsync(InputFileChangeEventArgs e) => RunAsync(async () =>
    {
        const long maxSize = 5 * 1024 * 1024;
        if (e.File.Size > maxSize)
        {
            throw new BusinessRuleException("import.file_too_large", "Файл больше 5 МБ.");
        }

        await using var upload = e.File.OpenReadStream(maxSize);
        using var buffer = new MemoryStream();
        await upload.CopyToAsync(buffer);
        buffer.Position = 0;
        _import = await Balances.ImportLinesAsync(Id, buffer, _doc!.RowVersion);
        if (_import.Applied)
        {
            _message = $"Загружено строк: {_import.Lines}.";
            _import = null;
        }
    }, null);

    private Task SubmitAsync() => RunAsync(() => Balances.SubmitAsync(Id, _doc!.RowVersion), "Документ отправлен на утверждение.");

    private Task CancelAsync() => RunAsync(() => Balances.CancelAsync(Id, _doc!.RowVersion), "Документ отменён.");

    private Task ApproveAsync() => RunAsync(() => Balances.ApproveAsync(Id, _doc!.RowVersion), "Документ утверждён, остатки записаны.");

    private Task ReturnAsync() => RunAsync(async () =>
    {
        await Balances.ReturnAsync(Id, _returnReason, _doc!.RowVersion);
        _returnReason = string.Empty;
    }, "Документ возвращён на доработку.");

    /// <summary>Одна операция за раз, затем свежий документ: у вкладки один DbContext.</summary>
    private async Task RunAsync(Func<Task> action, string? success)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _message = null;
        _messageIsError = false;
        try
        {
            await action();
            _message = success ?? _message;
        }
        catch (Exception ex) when (UiErrors.IsUserFacing(ex))
        {
            _message = UiErrors.Message(ex);
            _messageIsError = true;
        }
        finally
        {
            try
            {
                await LoadAsync();
            }
            finally
            {
                _busy = false;
            }
        }
    }

    private string Local(DateTime utc) => TimeZones.ToLocal(utc, CurrentAccess.TimeZoneId).ToString("dd.MM.yyyy HH:mm");
}
