@page "/period"
@using KnitErp.Application.Warehousing
@using KnitErp.Web.Components.Shared
@inject PeriodService Period

<PageTitle>@L("Закрытие периода") — knitERP</PageTitle>

@if (_denied is not null)
{
    <AccessDenied Message="@_denied" />
}
else if (_period is null)
{
    <p class="muted">@L("Загрузка…")</p>
}
else
{
    <h1>@L("Закрытие периода")</h1>
    <p class="muted">
        @L("После сверки остатков за месяц период закрывается: документы с датой в закрытом периоде не проводятся и не сторнируются, начальные остатки не утверждаются. Так сверенные цифры не меняются задним числом.")
    </p>

    @if (_message is not null)
    {
        <div class="@(_messageIsError ? "flash error" : "flash")" role="@(_messageIsError ? "alert" : "status")">@_message</div>
    }

    <dl class="facts">
        <dt>@L("Сейчас")</dt>
        <dd>@(_period.ClosedThrough is { } c ? L("закрыт по {0:dd.MM.yyyy} включительно", c) : L("закрытого периода нет"))</dd>
        @if (_period.ChangedBy is not null)
        {
            <dt>@L("Изменил")</dt><dd>@_period.ChangedBy, @TimeZones.ToLocal(_period.ChangedAtUtc!.Value, CurrentAccess.TimeZoneId).ToString("dd.MM.yyyy HH:mm")</dd>
        }
    </dl>

    @if (_period.CanManage)
    {
        <div class="panel">
            <h2>@L("Закрыть период")</h2>
            <form class="inline-form" @onsubmit="CloseAsync">
                <label>@L("Закрыть по (включительно)") <input type="date" @bind="_closeThrough" /></label>
                <button type="submit" disabled="@_busy">@L("Закрыть")</button>
            </form>
        </div>

        @if (_period.ClosedThrough is not null)
        {
            <div class="panel">
                <h2>@L("Открыть период")</h2>
                <p class="muted">@L("Граница сдвигается назад. Пустая дата — закрытого периода не будет. Причина попадёт в журнал аудита.")</p>
                <form class="inline-form" @onsubmit="ReopenAsync">
                    <label>@L("Новая граница") <input type="date" @bind="_reopenThrough" /></label>
                    <label>@L("Причина") <input @bind="_reason" maxlength="500" size="40" /></label>
                    <button type="submit" class="secondary" disabled="@_busy">@L("Открыть")</button>
                </form>
            </div>
        }
    }
    else
    {
        <p class="muted">@L("Закрывает и открывает период Владелец организации.")</p>
    }
}

@code {
    [CascadingParameter]
    public CurrentAccessDto CurrentAccess { get; set; } = default!;

    private PeriodDto? _period;
    private bool _busy;
    private string? _denied;
    private string? _message;
    private bool _messageIsError;
    private DateTime _closeThrough;
    private DateTime? _reopenThrough;
    private string _reason = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadAsync();
        }
        catch (AccessDeniedException ex)
        {
            _denied = UiErrors.Message(ex);
        }
    }

    private async Task LoadAsync()
    {
        _period = await Period.GetAsync();
        // Подсказка: последний день прошлого месяца.
        var today = TimeZones.ToLocal(DateTime.UtcNow, CurrentAccess.TimeZoneId).Date;
        _closeThrough = new DateTime(today.Year, today.Month, 1).AddDays(-1);
        _reopenThrough = null;
    }

    private Task CloseAsync() => RunAsync(() => Period.CloseAsync(DateOnly.FromDateTime(_closeThrough), _period!.RowVersion), L("Период закрыт."));

    private Task ReopenAsync() => RunAsync(async () =>
    {
        await Period.ReopenAsync(_reopenThrough is { } d ? DateOnly.FromDateTime(d) : null, _reason, _period!.RowVersion);
        _reason = string.Empty;
    }, L("Период открыт."));

    private async Task RunAsync(Func<Task> action, string success)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _message = null;
        _messageIsError = false;
        try
        {
            await action();
            _message = success;
        }
        catch (Exception ex) when (UiErrors.IsUserFacing(ex))
        {
            _message = UiErrors.Message(ex);
            _messageIsError = true;
        }
        finally
        {
            try
            {
                await LoadAsync();
            }
            finally
            {
                _busy = false;
            }
        }
    }
}
