@page "/integrity"
@using KnitErp.Application.Security
@inject IntegrityService Integrity

<PageTitle>Проверка целостности — knitERP</PageTitle>

<h1>Проверка целостности</h1>
<p class="muted">
    Каждая запись журнала аудита и движений склада подписана с учётом предыдущей. Ключ подписи хранится вне базы,
    поэтому изменение, удаление или добавление записи в обход программы — даже администратором базы — обнаруживается здесь.
</p>

@if (_denied is not null)
{
    <AccessDenied Message="@_denied" />
}
else
{
    <button type="button" @onclick="RunAsync" disabled="@_busy">@(_busy ? "Проверяю…" : "Проверить сейчас")</button>

    @if (_error is not null)
    {
        <div class="error" role="alert" style="margin-top: 12px">@_error</div>
    }

    @if (_result is not null)
    {
        var ok = _result.All(r => r.Ok);
        <div class="@(ok ? "flash" : "flash error")" role="status" style="margin-top: 16px">
            @(ok ? "Нарушений не найдено: записи не изменялись и не удалялись." : "Найдены нарушения — сообщите Владельцу и не исправляйте данные до разбора.")
        </div>
        @foreach (var j in _result)
        {
            <div class="panel">
                <h2>@j.Journal <span class="tag @(j.Ok ? "ok" : "bad")">@(j.Ok ? "в порядке" : $"нарушений: {j.Problems.Count}")</span></h2>
                <dl class="facts">
                    <dt>Проверено записей</dt><dd>@j.Checked</dd>
                    @if (j.Legacy > 0)
                    {
                        <dt>До включения подписи</dt><dd>@j.Legacy (их проверить нельзя)</dd>
                    }
                    <dt>Отпечаток</dt><dd><code>@(j.Fingerprint ?? "—")</code></dd>
                </dl>
                @if (j.Problems.Count > 0)
                {
                    <div class="scroll">
                        <table>
                            <thead><tr><th>Запись</th><th>Что не так</th></tr></thead>
                            <tbody>
                                @foreach (var p in j.Problems)
                                {
                                    <tr><td>№ @p.RecordId</td><td>@p.Description</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }
        <p class="muted">
            Отпечаток — номер и подпись последней записи. Запишите его после сверки периода: если позже хвост журнала
            удалят, номер или отпечаток не совпадут с записанным.
        </p>
    }
}

@code {
    private IReadOnlyList<JournalCheck>? _result;
    private string? _denied;
    private string? _error;
    private bool _busy;

    private async Task RunAsync()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            _result = await Integrity.VerifyAsync();
        }
        catch (AccessDeniedException ex)
        {
            _denied = ex.Message;
        }
        catch (Exception ex) when (UiErrors.IsUserFacing(ex))
        {
            _error = UiErrors.Message(ex);
        }
        finally
        {
            _busy = false;
        }
    }
}
