@page "/audit"
@using KnitErp.Application.Audit
@using KnitErp.Web.Components.Shared
@inject AuditQueryService Audit

<PageTitle>Журнал аудита — knitERP</PageTitle>

@if (_denied is not null)
{
    <AccessDenied Message="@_denied" />
}
else if (_rows is null)
{
    <p class="muted">Загрузка…</p>
}
else
{
    <h1>Журнал аудита</h1>
    <p class="muted">
        @(CurrentAccess.Has(Permissions.AuditLogView) ? "Все события организации" : "Только ваши действия и входы"),
        последние @_rows.Count. Время — @TimeZones.Label(CurrentAccess.TimeZoneId).
    </p>
    <div class="scroll">
        <table>
            <thead><tr><th>Время</th><th>Кто</th><th>Действие</th><th class="opt">Объект</th><th>Было → стало</th><th class="opt">Причина</th></tr></thead>
            <tbody>
                @foreach (var a in _rows)
                {
                    <tr>
                        <td style="white-space: nowrap">@TimeZones.ToLocal(a.OccurredAtUtc, CurrentAccess.TimeZoneId).ToString("dd.MM.yyyy HH:mm:ss")</td>
                        <td>@(a.ActorName ?? "система")</td>
                        <td><span class="tag">@AuditLabels.Action(a.Action)</span></td>
                        <td>@a.ObjectName</td>
                        <td>
                            @if (a.Before is not null || a.After is not null)
                            {
                                <span class="muted">@(a.Before ?? "—")</span> <span>→ @(a.After ?? "—")</span>
                            }
                        </td>
                        <td>@a.Reason</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="muted">Записи неизменяемы: изменить или удалить их не может никто, включая Владельца.</p>
}

@code {
    [CascadingParameter]
    public CurrentAccessDto CurrentAccess { get; set; } = default!;

    private IReadOnlyList<AuditRowDto>? _rows;
    private string? _denied;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _rows = await Audit.ListAsync();
        }
        catch (AccessDeniedException ex)
        {
            _denied = ex.Message;
        }
    }
}
