@page "/error"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout AccountLayout
@using System.Diagnostics

<PageTitle>@L("Ошибка") — knitERP</PageTitle>
<h1>@L("Что-то пошло не так")</h1>
<p>@L("Запрос не выполнен из-за внутренней ошибки. Данные не изменены, если операция не завершилась.")</p>
<p class="muted">@L("Попробуйте ещё раз. Если ошибка повторяется, сообщите администратору номер:")</p>
<p class="key">@_requestId</p>
<p><a href="./">@L("На главную")</a></p>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    // Номер запроса связывает обращение пользователя с записью в журнале приложения.
    private string? _requestId;

    protected override void OnInitialized() => _requestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
