@page "/roles"
@using KnitErp.Web.Components.Shared
@inject UserAccessService Access

<PageTitle>Роли и права — knitERP</PageTitle>

@if (_denied is not null)
{
    <AccessDenied Message="@_denied" />
}
else if (_matrix is null)
{
    <p class="muted">Загрузка…</p>
}
else
{
    <h1>Роли и права · матрица P0</h1>
    <p class="muted">Столбец вашей роли подсвечен. Права проверяются на сервере, запрет сильнее разрешения.</p>
    <div class="legend">
        <span><b>Д</b> да</span><span><b>О</b> только своя область</span><span><b>Ч</b> только чтение</span>
        <span><b>П</b> по отдельному праву</span><span><b>С</b> только своё</span><span><b>—</b> нет</span>
    </div>
    <div class="scroll">
        <table class="matrix">
            <thead>
                <tr>
                    <th>Действие</th>
                    @foreach (var r in _matrix.Roles)
                    {
                        <th class="@Mine(r.Code)">@r.Name</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _matrix.Rows)
                {
                    <tr>
                        <td>@row.Label<div class="muted">@row.PermissionCode</div></td>
                        @for (var i = 0; i < row.Levels.Count; i++)
                        {
                            <td class="@Mine(_matrix.Roles[i].Code)">@row.Levels[i].Symbol()</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [CascadingParameter]
    public CurrentAccessDto CurrentAccess { get; set; } = default!;

    private RoleMatrixDto? _matrix;
    private string? _denied;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _matrix = await Access.GetRoleMatrixAsync();
        }
        catch (AccessDeniedException ex)
        {
            _denied = ex.Message;
        }
    }

    private string? Mine(string roleCode) => CurrentAccess.RoleCodes.Contains(roleCode) ? "mine" : null;
}
